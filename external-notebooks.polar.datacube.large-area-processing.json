":"outputs","id":"0U9x1xceK3RxlLoUpRRWj","children":[],"key":"NyFyhHbjIS"}],"key":"iWDA1v57d7"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Connect with Data Cube","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ZopljA6PZr"}],"identifier":"connect-with-data-cube","label":"Connect with Data Cube","html_id":"connect-with-data-cube","implicit":true,"key":"bozy49r1vN"}],"key":"CNnXNPvUU3"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"combined_url = \"https://s3.waw4-1.cloudferro.com/EarthCODE/OSCAssets/antarctica_cube/land-ice/antarctica-combined.zarr\"\nds = xr.open_zarr(combined_url, group=\"0\", chunks={})\nds\n","key":"EXBhXXSqEc"},{"type":"outputs","id":"eK91zwA-79EerOYpDwXqc","children":[],"key":"V5HwqOw7BF"}],"key":"hvZCYgHBYv"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"dx = abs((ds.x.isel(x=1) - ds.x.isel(x=0)).load().item())\ndy = abs((ds.y.isel(y=1) - ds.y.isel(y=0)).load().item())\nkm2 = dx * dy / 1e6\n\nds[[\n    \"mask\",\n    \"bed\",\n    \"thickness\",\n    \"errbed\",\n    \"ice_shelf_basal_melt_rate\",\n    \"groundlines_mask\",\n    \"subglacial_lakes_extents_mask\",\n    \"supra_glacial_lakes_mask\",\n]]\n","key":"kba7ngv5za"},{"type":"outputs","id":"_nGKa-icR-vOQB3fb9cmu","children":[],"key":"HMmIUXWn2w"}],"key":"FgeArJcynI"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Area of the main surface classes","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ZTLSYRQT13"}],"identifier":"area-of-the-main-surface-classes","label":"Area of the main surface classes","html_id":"area-of-the-main-surface-classes","implicit":true,"key":"Ux4T517y7d"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Mask codes: 0 ocean, 1 ice-free land, 2 grounded ice, 3 floating ice, 4 Lake Vostok.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"fDjYFOEQqM"}],"key":"IVcZMMDp3c"}],"key":"sY63UbJnlG"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"mask = ds[\"mask\"]\n\nsurface_area = xr.Dataset({\n    \"ocean\": (mask == 0).sum() * km2,\n    \"ice_free_land\": (mask == 1).sum() * km2,\n    \"grounded_ice\": (mask == 2).sum() * km2,\n    \"floating_ice\": (mask == 3).sum() * km2,\n    \"lake_vostok\": (mask == 4).sum() * km2,\n}).compute()\n\nsurface_area.to_array().to_series().rename(\"area_km2\").to_frame()\n","key":"SG6UFNwvQn"},{"type":"outputs","id":"egVUMoLB3nKO_FMQ-OnQC","children":[],"key":"Aj1J2bdP0B"}],"key":"nrtZkcJbTi"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Example 1: marine-based grounded ice exposure","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"JyQ4FKOSbd"}],"identifier":"example-1-marine-based-grounded-ice-exposure","label":"Example 1: marine-based grounded ice exposure","html_id":"example-1-marine-based-grounded-ice-exposure","implicit":true,"key":"rhpElkkjUG"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"This estimates how much grounded ice sits on bed below sea level, including deep basins below -1000 m.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"wt9asXlPlJ"}],"key":"Ytn08U9dK3"}],"key":"bWGONx4hjC"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"bed = ds[\"bed\"]\nthickness = ds[\"thickness\"]\nerr = ds[\"errbed\"]\nmarine = (mask == 2) & (bed < 0)\n\nmarine_summary = xr.Dataset({\n    \"grounded_ice_bed_below_0m_km2\": marine.sum() * km2,\n    \"grounded_ice_bed_below_minus_1000m_km2\": (marine & (bed < -1000)).sum() * km2,\n    \"mean_bed_elevation_m\": bed.where(marine).mean(),\n    \"mean_ice_thickness_m\": thickness.where(marine).mean(),\n    \"mean_bed_error_m\": err.where(marine).mean(),\n}).compute()\n\nmarine_summary.to_array().to_series().rename(\"value\").to_frame()\n","key":"gTxKank59J"},{"type":"outputs","id":"k7eqUuZ4uiaqJGqJnV-m2","children":[],"key":"eC8e8Co4lr"}],"key":"ymuA9qNLoH"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Example 2: floating-ice basal melt and a 5 km grounding-zone buffer","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Gw7fmPFwyN"}],"identifier":"example-2-floating-ice-basal-melt-and-a-5-km-grounding-zone-buffer","label":"Example 2: floating-ice basal melt and a 5 km grounding-zone buffer","html_id":"example-2-floating-ice-basal-melt-and-a-5-km-grounding-zone-buffer","implicit":true,"key":"lYULpGF2wt"}],"key":"Op6kfzO7OU"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from scipy.ndimage import binary_dilation\n\nmelt = ds[\"ice_shelf_basal_melt_rate\"]\nfloating = (mask == 3) & melt.notnull()\n\ngl5 = da.map_overlap(\n    binary_dilation,\n    ds[\"groundlines_mask\"].data.astype(bool),\n    depth=5,\n    boundary=False,\n    dtype=bool,\n    structure=np.ones((11, 11), bool),\n)\ngrounding_zone = xr.DataArray(gl5, coords=mask.coords, dims=mask.dims) & floating\n\nmelt_summary = xr.Dataset({\n    \"floating_ice_with_melt_data_km2\": floating.sum() * km2,\n    \"floating_ice_mean_melt_m\": melt.where(floating).mean(),\n    \"floating_ice_net_melt_km3_per_dataset_unit\": melt.where(floating).sum() * km2 / 1000,\n    \"grounding_zone_5km_area_km2\": grounding_zone.sum() * km2,\n    \"grounding_zone_5km_mean_melt_m\": melt.where(grounding_zone).mean(),\n}).compute()\n\nmelt_summary.to_array().to_series().rename(\"value\").to_frame()\n","key":"ZRkuEobFZ3"},{"type":"outputs","id":"QwFvlGFSALT-sSeJrzSw8","children":[],"key":"OHohty4w9N"}],"key":"mPrRUMKvof"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"client.close()\n","key":"ARknnnVsBH"},{"type":"outputs","id":"iCOd6vfQFWn1KaP7UHVE8","children":[],"key":"FMOorlJz2f"}],"key":"pcyelYxX3m"}],"key":"PPPjqmyWV1"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Build one local datacube for a small ROI","url":"/external-notebooks/polar/datacube/build-single-cube-demo","group":"Datacube"},"next":{"title":"Accessing External Datasets","url":"/external-notebooks/polar/datacube/accessing-external-datasets/intro","group":"Accessing External Datasets"}}},"domain":"http://localhost:3000"}