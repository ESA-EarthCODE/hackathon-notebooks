],"key":"pTeycFVejm"}],"key":"poOaDHEBth"}],"key":"MWZjT5Im3t"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"item.assets[\"data\"].href","key":"lSlbgBe3VP"},{"type":"outputs","id":"qsOHigtRPgmRgwkAMxjzw","children":[],"key":"PaFFPHAcgi"}],"key":"EIwsvmyeq1"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-15T00:25:57.531180Z","iopub.status.busy":"2026-11-15T00:25:57.531017Z","iopub.status.idle":"2026-11-15T00:25:59.035052Z","shell.execute_reply":"2026-11-15T00:25:59.034086Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"ds = xr.open_zarr(item.assets[\"data\"].href)\nds","key":"GwUtx4B6Ow"},{"type":"outputs","id":"x6wrzwHD1w5YK9gbqpfn9","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":2,"metadata":{},"data":{"text/html":{"content_type":"text/html","hash":"1ba144f5765e0416b289ffb0cb77285c","path":"/hackathon-notebooks/build/1ba144f5765e0416b289ffb0cb77285c.html"},"text/plain":{"content":"<xarray.Dataset> Size: 278MB\nDimensions:  (time: 36, lat: 278, lon: 694)\nCoordinates:\n  * time     (time) datetime64[ns] 288B 2019-01-01 2019-02-01 ... 2021-12-01\n  * lat      (lat) float64 2kB 30.04 30.11 30.18 30.25 ... 49.86 49.93 50.0\n  * lon      (lon) float64 6kB -9.964 -9.892 -9.82 -9.748 ... 39.84 39.91 39.98\nData variables:\n    DIATO    (time, lat, lon) float64 56MB dask.array<chunksize=(36, 278, 694), meta=np.ndarray>\n    DINO     (time, lat, lon) float64 56MB dask.array<chunksize=(36, 278, 694), meta=np.ndarray>\n    GREEN    (time, lat, lon) float64 56MB dask.array<chunksize=(36, 278, 694), meta=np.ndarray>\n    HAPTO    (time, lat, lon) float64 56MB dask.array<chunksize=(36, 278, 694), meta=np.ndarray>\n    PROKA    (time, lat, lon) float64 56MB dask.array<chunksize=(36, 278, 694), meta=np.ndarray>\nAttributes:\n    title:        Gridded phytoplankton functional types (PFTs) at 8.0 km res...\n    institution:  Alfred Wegener Institute\n    source:       Extracted from Copernicus Marine Service OCEANCOLOUR_GLO_BG...\n    history:      Created on 02-Jun-2025 14:44:02","content_type":"text/plain"}}},"children":[],"key":"zKepRif2o2"}],"key":"m828GECUE1"}],"key":"Ug8oL2AgR3"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Plot the phytoplankton functional type contributing the most chlorophyll at each grid cell during the summer months","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"mSZ3teLImn"}],"identifier":"plot-the-phytoplankton-functional-type-contributing-the-most-chlorophyll-at-each-grid-cell-during-the-summer-months","label":"Plot the phytoplankton functional type contributing the most chlorophyll at each grid cell during the summer months","html_id":"plot-the-phytoplankton-functional-type-contributing-the-most-chlorophyll-at-each-grid-cell-during-the-summer-months","implicit":true,"key":"OtDe0p8EsC"}],"key":"vU6ORtfiea"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-15T00:25:59.052273Z","iopub.status.busy":"2026-11-15T00:25:59.051985Z","iopub.status.idle":"2026-11-15T00:25:59.071306Z","shell.execute_reply":"2026-11-15T00:25:59.070288Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"import numpy as np\nimport xarray as xr\n\npft_names = [\"DIATO\", \"DINO\", \"GREEN\", \"HAPTO\", \"PROKA\"]\n\npft = ds[pft_names].to_array(dim=\"pft\")\nsummer = pft.sel(\n    time=pft.time.dt.month.isin([6, 7, 8])\n).mean(\"time\")\n","key":"rls3kdsiDG"},{"type":"outputs","id":"R0E-HDdbhnkcu0O2fWsQv","children":[],"key":"IZa9MOYPym"}],"key":"XOREF1jVCk"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"total_chlorophyll is the combined chlorophyll concentration of the five groups. dominant_pft stores the index of the group with the highest concentration at each grid cell.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"cPtSJ6rsiq"}],"key":"sbpNmYU8g5"}],"key":"FCJjjp77Fp"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-15T00:25:59.089558Z","iopub.status.busy":"2026-11-15T00:25:59.089381Z","iopub.status.idle":"2026-11-15T00:26:38.003261Z","shell.execute_reply":"2026-11-15T00:26:38.002626Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"total_chlorophyll = summer.sum(\"pft\", min_count=1)\n\ndominant_pft = (\n    summer.fillna(-np.inf)\n    .argmax(\"pft\")\n    .where(total_chlorophyll.notnull())\n)\n\ntotal_chlorophyll = total_chlorophyll.compute()\ndominant_pft = dominant_pft.compute()","key":"b8gv1Sq80i"},{"type":"outputs","id":"EVm56SAnJUBqWe0fufEmh","children":[],"key":"bEJDT6C4lJ"}],"key":"NZ6xGeCAy2"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-15T00:26:38.014747Z","iopub.status.busy":"2026-11-15T00:26:38.014573Z","iopub.status.idle":"2026-11-15T00:26:38.991614Z","shell.execute_reply":"2026-11-15T00:26:38.990991Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"import matplotlib.pyplot as plt\nimport matplotlib.patches as mpatches\nfrom matplotlib.colors import ListedColormap, BoundaryNorm\n\nimport cartopy.crs as ccrs\nimport cartopy.feature as cfeature\n\npft_colours = [\n    \"#d95f02\",  # Diatoms\n    \"#7570b3\",  # Dinoflagellates\n    \"#1b9e77\",  # Green algae\n    \"#e6ab02\",  # Haptophytes\n    \"#66a9c9\",  # Prokaryotic phytoplankton\n]\n\npft_labels = [\n    \"Diatoms\",\n    \"Dinoflagellates\",\n    \"Green algae\",\n    \"Haptophytes\",\n    \"Prokaryotic phytoplankton\",\n]\n\ncmap = ListedColormap(pft_colours)\nnorm = BoundaryNorm(np.arange(-0.5, 5.5, 1), cmap.N)\n\nprojection = ccrs.PlateCarree()\n\nfig = plt.figure(figsize=(13, 7))\nax = plt.axes(projection=projection)\n\nax.set_extent(\n    [\n        float(ds.lon.min()),\n        float(ds.lon.max()),\n        float(ds.lat.min()),\n        float(ds.lat.max()),\n    ],\n    crs=projection,\n)\n\nax.pcolormesh(\n    ds.lon,\n    ds.lat,\n    dominant_pft,\n    cmap=cmap,\n    norm=norm,\n    shading=\"auto\",\n    transform=projection,\n)\n\n\nax.add_feature(cfeature.LAND, facecolor=\"lightgrey\", zorder=3)\nax.coastlines(resolution=\"50m\", linewidth=0.7, zorder=4)\n\nlegend_handles = [\n    mpatches.Patch(color=colour, label=label)\n    for colour, label in zip(pft_colours, pft_labels)\n]\n\nax.legend(\n    handles=legend_handles,\n    title=\"Dominant PFT\",\n    loc=\"upper left\",\n    frameon=True,\n)\n\nax.set_title(\n    \"Dominant phytoplankton functional type and total chlorophyll\\n\"\n    \"Summer, 2019–2021\"\n)\n\nplt.tight_layout()\nplt.show()","key":"lQmxhgqnPV"},{"type":"outputs","id":"j8Kzg6m_qVe310WgBCOz6","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"a881e5c169826791f5565658e59bcf38","path":"/hackathon-notebooks/build/a881e5c169826791f5565658e59bcf38.png"},"text/plain":{"content":"<Figure size 1300x700 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"kCIRVy1XOW"}],"key":"zjEFpZIs6N"}],"key":"llf80HFELf"}],"key":"jXhsGsQ14T"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Datasets prepared for the Ocean Hackathon","url":"/external-notebooks/ocean/datasets/datasets-sumary","group":"Datasets"},"next":{"title":"Access 4DMED-SEA 4DVarNet 1/8°","url":"/external-notebooks/ocean/datasets/dmed-4dvar-8/access","group":"Dmed 4dvar 8"}}},"domain":"http://localhost:3000"}