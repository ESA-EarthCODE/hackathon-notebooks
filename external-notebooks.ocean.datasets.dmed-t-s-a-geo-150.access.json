[&quot;degree&quot;,0.0174532925199433,AUTHORITY[&quot;EPSG&quot;,&quot;9122&quot;]],AXIS[&quot;Latitude&quot;,NORTH],AXIS[&quot;Longitude&quot;,EAST],AUTHORITY[&quot;EPSG&quot;,&quot;4326&quot;]]</dd></dl></div><div class='xr-var-data'><pre>array(0)</pre></div></li><li class='xr-var-item'><div class='xr-var-name'><span>time</span></div><div class='xr-var-dims'>()</div><div class='xr-var-dtype'>datetime64[ns]</div><div class='xr-var-preview xr-preview'>2016-01-16</div><input id='attrs-abcafec3-45f7-4b9a-b62f-0de40edafa8b' class='xr-var-attrs-in' type='checkbox' ><label for='attrs-abcafec3-45f7-4b9a-b62f-0de40edafa8b' title='Show/Hide attributes'><svg class='icon xr-icon-file-text2'><use xlink:href='#icon-file-text2'></use></svg></label><input id='data-159aa6f7-a06c-4578-b8de-d7e8d6fd0f21' class='xr-var-data-in' type='checkbox'><label for='data-159aa6f7-a06c-4578-b8de-d7e8d6fd0f21' title='Show/Hide data repr'><svg class='icon xr-icon-database'><use xlink:href='#icon-database'></use></svg></label><div class='xr-var-attrs'><dl class='xr-attrs'><dt><span>long_name :</span></dt><dd>time</dd><dt><span>standard_name :</span></dt><dd>time</dd><dt><span>axis :</span></dt><dd>T</dd></dl></div><div class='xr-var-data'><pre>array(&#x27;2016-01-16T00:00:00.000000000&#x27;, dtype=&#x27;datetime64[ns]&#x27;)</pre></div></li></ul></div></li><li class='xr-section-item'><input id='section-6481f560-a0d7-4c71-9a6a-36930d2e8bd1' class='xr-section-summary-in' type='checkbox' checked /><label for='section-6481f560-a0d7-4c71-9a6a-36930d2e8bd1' class='xr-section-summary' title='Expand/collapse section'>Attributes: <span>(4)</span></label><div class='xr-section-inline-details'></div><div class='xr-section-details'><dl class='xr-attrs'><dt><span>units :</span></dt><dd>degrees_C</dd><dt><span>long_name :</span></dt><dd>Neural network reconstruction of 3D Mediterranean temperature field from surface obs at 1/24 deg</dd><dt><span>standard_name :</span></dt><dd>sea_water_temperature</dd><dt><span>grid_mapping :</span></dt><dd>spatial_ref</dd></dl></div></li></ul></div></div>","content_type":"text/html"},"text/plain":{"content":"<xarray.DataArray 'TEMP3D' (lat: 378, lon: 1012)> Size: 2MB\narray([[nan, nan, nan, ..., nan, nan, nan],\n       [nan, nan, nan, ..., nan, nan, nan],\n       [nan, nan, nan, ..., nan, nan, nan],\n       ...,\n       [nan, nan, nan, ..., nan, nan, nan],\n       [nan, nan, nan, ..., nan, nan, nan],\n       [nan, nan, nan, ..., nan, nan, nan]],\n      shape=(378, 1012), dtype=float32)\nCoordinates:\n  * lat          (lat) float32 2kB 30.27 30.31 30.35 30.4 ... 45.9 45.94 45.98\n  * lon          (lon) float32 4kB -6.062 -6.021 -5.979 ... 35.98 36.02 36.06\n    depth        float32 4B -3.0\n    spatial_ref  int64 8B 0\n    time         datetime64[ns] 8B 2016-01-16\nAttributes:\n    units:          degrees_C\n    long_name:      Neural network reconstruction of 3D Mediterranean tempera...\n    standard_name:  sea_water_temperature\n    grid_mapping:   spatial_ref","content_type":"text/plain"}}},"children":[],"key":"swa5amB5ik"}],"key":"ig5dPmARP6"}],"key":"Bc4HIf6gCP"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import matplotlib.pyplot as plt\nimport cartopy.crs as ccrs\nimport cartopy.feature as cfeature\n\n# Set up the figure and the map projection\nfig, ax = plt.subplots(figsize=(12, 8), subplot_kw={'projection': ccrs.PlateCarree()})\n\n# Add geographic features for context\nax.add_feature(cfeature.COASTLINE, linewidth=0.8)\nax.add_feature(cfeature.LAND, facecolor='lightgray', zorder=100) # Put land on top of ocean\nax.add_feature(cfeature.BORDERS, linestyle=':', linewidth=0.5)\n\n# 3. Plot filled contours (the colors)\nfilled_c = surface_temp.plot.contourf(\n    ax=ax,\n    x='lon',\n    y='lat',\n    transform=ccrs.PlateCarree(),\n    levels=20,               # Number of color gradients\n    cmap='RdYlBu_r',         # Red-Yellow-Blue colormap (reversed so red=warm)\n    cbar_kwargs={'label': 'Temperature (°C)'}\n)\n\n# plot contour lines on top\nlines_c = surface_temp.plot.contour(\n    ax=ax,\n    x='lon',\n    y='lat',\n    transform=ccrs.PlateCarree(),\n    levels=20,               # Keep levels identical to contourf to match boundaries\n    colors='black',          # Black lines\n    linewidths=0.5,\n    alpha=0.5                # Slightly transparent\n)\n\n# Add a title dynamically using xarray attributes if they exist\ntime_str = str(surface_temp.time.values)[:10] # Gets 'YYYY-MM-DD'\nax.set_title(f\"Mediterranean Sea Surface Temperature\\nDate: {time_str}\")\n\nplt.show()","key":"Yx4WJdRPej"},{"type":"outputs","id":"HdFEdtJ_VVfLzUL-WmqPw","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"70ed247c4b83536133ed9548cca8cda8","path":"/hackathon-notebooks/build/70ed247c4b83536133ed9548cca8cda8.png"},"text/plain":{"content":"<Figure size 1200x800 with 2 Axes>","content_type":"text/plain"}}},"children":[],"key":"zpNZOgWgQc"}],"key":"hHC5tEszjz"}],"key":"o90h550zaT"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Visualisation","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"fDp6Cl7CbM"}],"identifier":"visualisation","label":"Visualisation","html_id":"visualisation","implicit":true,"key":"NjOpLAvX3H"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"This dataset is in geozarr format, however it is not optimised for visualisaiton, but for analysis and therefore is chunked along the temporal and depth dimensions as well as spatially. Nevertheless, since  the data is available at multiple resolutions it can be interactively visualised by any GeoZarr viewer by passing the dataset url. For example:",