":"2026-11-15T00:43:00.867427Z","shell.execute_reply":"2026-11-15T00:43:00.867057Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"vmin = subset.min(skipna=True).values\nvmax = subset.max(skipna=True).values\n\nfig, axes = plt.subplots(\n    nrows=1,\n    ncols=3,\n    figsize=(18, 6),\n    constrained_layout=True\n)\n\nfor ax, t in zip(axes, subset.time):\n    plot_data = da.sel(time=t)\n\n    im = ax.pcolormesh(\n        ds[\"x\"],\n        ds[\"y\"],\n        plot_data,\n        shading=\"auto\",\n        vmin=vmin,\n        vmax=vmax,\n        cmap=\"viridis\"\n    )\n\n    ax.set_title(f\"SSS\\n{t.dt.strftime('%Y-%m-%d %H:%M').item()}\")\n    ax.set_xlabel(\"x [m]\")\n    ax.set_ylabel(\"y [m]\")\n    ax.set_aspect(\"equal\")\n\n# shared colorbar\ncbar = fig.colorbar(im, ax=axes, orientation=\"vertical\", shrink=0.8)\ncbar.set_label(\"Sea Surface Salinity\")\n\nplt.show()","key":"CXk1xhawpi"},{"type":"outputs","id":"CsbMcla6u9j-hKydazzcl","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"af11e24ccf5096a0d2507fc9adaf4916","path":"/af11e24ccf5096a0d2507fc9adaf4916.png"},"text/plain":{"content":"<Figure size 1800x600 with 4 Axes>","content_type":"text/plain"}}},"children":[],"key":"OREJK4MP5u"}],"key":"iK73HcPFhQ"}],"key":"aFUsdjytKN"}],"key":"cIWJIwawLJ"},"references":{"cite":{"order":[],"data":{}}}}