ubfolder.\"\"\"\n    start = start.resolve()\n    for path in (start, *start.parents):\n        if (path / \".git\").exists() or (path / \"downloaded_data\").exists():\n            return path\n    return start\n\n\nREPO_ROOT = find_repo_root()\nDATA_DIR = REPO_ROOT / \"downloaded_data\"\nDATA_DIR.mkdir(exist_ok=True)\n\nimport zipfile\nimport geopandas as gpd\n\nZIP_PATH = DATA_DIR / \"WAIS_Max_Extent.zip\"\nTARGET_FILE = \"WAIS_Max_Extent/WAIS_Jan_2017_Polygons.shp\"\nPARQUET_FILE = DATA_DIR / \"WAIS_Jan_2017_Polygons.parquet\"\n","key":"R7w1QAFFfB"},{"type":"outputs","id":"3Xr0BVQoGSWe_OT7ZtqQ2","children":[],"key":"HzDq1uJRpG"}],"key":"j8lowNfi25"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Read The Shapefile Directly From The ZIP Archive","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"IrU6jqCxxd"}],"identifier":"read-the-shapefile-directly-from-the-zip-archive","label":"Read The Shapefile Directly From The ZIP Archive","html_id":"read-the-shapefile-directly-from-the-zip-archive","implicit":true,"key":"ARmgTluARr"}],"key":"kGd77HfOlA"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"uri = f\"zip://{ZIP_PATH}!{TARGET_FILE}\"\ngdf = gpd.read_file(uri)\n\ngdf.head()\n","key":"IEXBiEfMpn"},{"type":"outputs","id":"Z7a8qDgHht668HiawM9so","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":2,"metadata":{},"data":{"text/html":{"content":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      