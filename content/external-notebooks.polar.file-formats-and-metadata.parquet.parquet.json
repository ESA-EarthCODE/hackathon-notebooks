":[{"type":"text","value":"Parquet files are laid out differently from row-oriented formats like CSV or FlatGeobuf.","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"key":"QK21WLClHJ"}],"key":"XM1R6t1SzH"},{"type":"image","url":"/geoparquet_layout-488a57bfdab517c363246dcc9bfc21c0.png","alt":"Schematic of Parquet file layout","position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"key":"RKZbYRDhxr","urlSource":"../../static/geoparquet_layout.png"},{"type":"paragraph","position":{"start":{"line":87,"column":1},"end":{"line":87,"column":1}},"children":[{"type":"text","value":"A Parquet file consists of a sequence of chunks called row groups. Each row group contains column chunks: contiguous blocks of values for each column. All row groups in the file share the same schema.","position":{"start":{"line":87,"column":1},"end":{"line":87,"column":1}},"key":"WJyIIg2mJQ"}],"key":"DgVoNHGGLt"},{"type":"paragraph","position":{"start":{"line":89,"column":1},"end":{"line":89,"column":1}},"children":[{"type":"text","value":"The file footer stores metadata describing the schema, the byte range of every column chunk, and optional column statistics such as minimum and maximum values. A reader usually fetches the footer first, then makes targeted reads for the columns and row groups needed by a query.","position":{"start":{"line":89,"column":1},"end":{"line":89,"column":1}},"key":"CnVuEmOKqm"}],"key":"NlRRkQ19ev"},{"type":"heading","depth":3,"position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"children":[{"type":"text","value":"Column-Oriented","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"key":"HkoBlwfo44"}],"identifier":"column-oriented","label":"Column-Oriented","html_id":"column-oriented","implicit":true,"key":"O9PJO4C1Wv"},{"type":"paragraph","position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"children":[{"type":"text","value":"The bytes of each column are contiguous,