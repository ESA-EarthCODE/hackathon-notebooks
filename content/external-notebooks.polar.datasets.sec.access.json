/b57e9afbac5c691dc94d027a2ac1dd55.html"},"text/plain":{"content":"<xarray.Dataset> Size: 616MB\nDimensions:            (y: 968, x: 1128, time: 27, bounds: 2)\nCoordinates:\n  * y                  (y) float32 4kB -2.418e+06 -2.412e+06 ... 2.418e+06\n  * x                  (x) float32 5kB -2.818e+06 -2.812e+06 ... 2.818e+06\n    lat                (y, x) float64 9MB dask.array<chunksize=(968, 1128), meta=np.ndarray>\n    lon                (y, x) float64 9MB dask.array<chunksize=(968, 1128), meta=np.ndarray>\n  * time               (time) datetime64[ns] 216B 1993-12-01 ... 2020-01-01\nDimensions without coordinates: bounds\nData variables:\n    basin_id           (y, x) float32 4MB dask.array<chunksize=(968, 1128), meta=np.ndarray>\n    cell_end_times     (time, y, x) float32 118MB dask.array<chunksize=(27, 968, 1128), meta=np.ndarray>\n    cell_start_times   (time, y, x) float32 118MB dask.array<chunksize=(27, 968, 1128), meta=np.ndarray>\n    cell_time_lengths  (time, y, x) float32 118MB dask.array<chunksize=(27, 968, 1128), meta=np.ndarray>\n    grid_projection    int64 8B ...\n    sec                (time, y, x) float32 118MB dask.array<chunksize=(27, 968, 1128), meta=np.ndarray>\n    sec_uncertainty    (time, y, x) float32 118MB dask.array<chunksize=(27, 968, 1128), meta=np.ndarray>\n    surface_type       (y, x) float32 4MB dask.array<chunksize=(968, 1128), meta=np.ndarray>\n    time_bounds        (time, bounds) datetime64[ns] 432B dask.array<chunksize=(27, 2), meta=np.ndarray>\nAttributes: (12/40)\n    title:                  5yr Antarctic Surface Elevation Change at 5.0km r...\n    institution:            University College London (UCL)\n    creator_email:          cpom@leeds.ac.uk\n    creator_name:           University College London (UCL), Centre for Polar...\n    creator_url:            www.cpom.ucl.ac.uk/csopr\n    comment:                This data was prepared by UCL as a part of the ES...\n    ...                     ...\n    spatial_resolution:     5km grid\n    dhdt_sw_version:        0ded87aa6\n    product_sw_version:     0ded87aa6\n    product_created:        2021-06-03T11:07:35Z\n    license:                ESA CCI Data Policy: free and open access\n    netCDF_version:         NETCDF4","content_type":"text/plain"}}},"children":[],"key":"L1bDtdijrY"}],"key":"TyhqBUj1n2"}],"key":"qfnyobdGXk"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-15T00:41:48.842952Z","iopub.status.busy":"2026-11-15T00:41:48.842708Z","iopub.status.idle":"2026-11-15T00:41:48.858278Z","shell.execute_reply":"2026-11-15T00:41:48.857909Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"# compute surface evelavtion change trend\nsec = ds.sec.where(ds.surface_type == 2)\nunc = ds.sec_uncertainty.where(ds.surface_type == 2)\n\nt = (ds.time.dt.year + (ds.time.dt.dayofyear - 1) / 365.25)\nt = t - t.mean()\n\nsec_y = sec.assign_coords(year=(\"time\", ds.time.dt.year.values))\ntrend = sec_y.swap_dims({\"time\": \"year\"}).polyfit(\"year\", 1).polyfit_coefficients.sel(degree=1)\ntrend = trend * 1000   # mm yr-2, change in SEC rate per year","key":"pwhuKr5v7j"},{"type":"outputs","id":"5ZiBUgoXqJU50qNIPn4vi","children":[],"key":"ksoK0dlIf9"}],"key":"d2oZwMJdxG"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-15T00:41:48.869220Z","iopub.status.busy":"2026-11-15T00:41:48.869128Z","iopub.status.idle":"2026-11-15T00:41:48.873864Z","shell.execute_reply":"2026-11-15T00:41:48.873502Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"mean_sec = sec.mean(\"time\") * 1000\nmean_unc = unc.mean(\"time\") * 1000\nsignal_to_noise = abs(mean_sec) / mean_unc\nmean_sec = mean_sec.where(signal_to_noise <= 2)","key":"pejPzGQHac"},{"type":"outputs","id":"bTonkPOF7277_-iIG9iiS","children":[],"key":"QdYF6yUnZP"}],"key":"nTwVhgJ6z7"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-15T00:41:48.883878Z","iopub.status.busy":"2026-11-15T00:41:48.883813Z","iopub.status.idle":"2026-11-15T00:42:21.700063Z","shell.execute_reply":"2026-11-15T00:42:21.699692Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"fig, ax = plt.subplots(figsize=(9, 8))\n\nim = ax.pcolormesh(\n    ds.x / 1000, ds.y / 1000, mean_sec,\n    shading=\"auto\", cmap=\"RdBu\", vmin=-500, vmax=500\n)\n\ntrend_for_contour = trend.where(np.isfinite(mean_sec))\ntrend_for_contour = trend_for_contour.rolling(x=9, y=9, center=True, min_periods=41).mean()\ntrend_for_contour = trend_for_contour.where(np.isfinite(mean_sec))\ncontour = ax.contour(\n    ds.x / 1000, ds.y / 1000, trend_for_contour,\n    levels=[-16, -8, 8, 16],\n    colors=\"k\", linewidths=0.5, alpha=0.75, zorder=3\n)\n\nax.set_aspect(\"equal\")\nax.set_title(\"Antarctic surface elevation change fingerprint\\nmean SEC with acceleration contours and SNR<2 boundary\")\nax.set_xlabel(\"Polar stereographic x (km)\")\nax.set_ylabel(\"Polar stereographic y (km)\")\n\ncb = plt.colorbar(im, ax=ax, shrink=0.8)\ncb.set_label(\"Mean surface elevation change, 1991–2022 5-year windows (mm/yr)\")\n\nplt.show()","key":"Jxznss81lg"},{"type":"outputs","id":"hrEZhKDAT_lvWPrVW5rkD","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"f1b03639709600103accb5fbdb2a05cb","path":"/f1b03639709600103accb5fbdb2a05cb.png"},"text/plain":{"content":"<Figure size 900x800 with 2 Axes>","content_type":"text/plain"}}},"children":[],"key":"AYv0CMgcuz"}],"key":"UJZKYQ88v9"}],"key":"NJNXnSnHBU"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Group by IBIE basin ID","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"rSHjX81fKu"}],"identifier":"group-by-ibie-basin-id","label":"Group by IBIE basin ID","html_id":"group-by-ibie-basin-id","implicit":true,"key":"yfhCashfdN"}],"key":"LNGiZhPWdO"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-15T00:42:21.721388Z","iopub.status.busy":"2026-11-15T00:42:21.721294Z","iopub.status.idle":"2026-11-15T00:42:21.725123Z","shell.execute_reply":"2026-11-15T00:42:21.724797Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"ds.basin_id","key":"rV58XkYNBn"},{"type":"outputs","id":"Y5D-_TTq9Rp_FIYfXZf68","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":7,"metadata":{},"data":{"text/html":{"content_type":"text/html","hash":"33942dfade5da4e3c9dbced78f238f8a","path":"/33942dfade5da4e3c9dbced78f238f8a.html"},"text/plain":{"content":"<xarray.DataArray 'basin_id' (y: 968, x: 1128)> Size: 4MB\ndask.array<open_dataset-basin_id, shape=(968, 1128), dtype=float32, chunksize=(968, 1128), chunktype=numpy.ndarray>\nCoordinates:\n  * y        (y) float32 4kB -2.418e+06 -2.412e+06 ... 2.412e+06 2.418e+06\n  * x        (x) float32 5kB -2.818e+06 -2.812e+06 ... 2.812e+06 2.818e+06\n    lat      (y, x) float64 9MB dask.array<chunksize=(968, 1128), meta=np.ndarray>\n    lon      (y, x) float64 9MB dask.array<chunksize=(968, 1128), meta=np.ndarray>\nAttributes:\n    long_name:     Glacialogical basin identification number\n    comment:       IMBIE glacialogical basin id number (Zwally et al., 2012) ...\n    source:        IMBIE http://imbie.org/imbie-2016/drainage-basins/\n    grid_mapping:  grid_projection","content_type":"text/plain"}}},"children":[],"key":"G522VZHjPy"}],"key":"ZBjt3dOJVW"}],"key":"sh5dhtMFAH"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-15T00:42:21.741501Z","iopub.status.busy":"2026-11-15T00:42:21.741434Z","iopub.status.idle":"2026-11-15T00:43:16.309705Z","shell.execute_reply":"2026-11-15T00:43:16.309400Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"basin 