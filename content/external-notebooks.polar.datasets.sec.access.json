nfig, ax = plt.subplots(figsize=(9, 8))\n\nbasin_map.plot(\n    column=\"mean_sec_mm_yr\",\n    ax=ax,\n    cmap=\"RdBu_r\",\n    norm=norm,\n    legend=True,\n    legend_kwds={\n        \"label\": \"Mean surface elevation change by basin (mm/yr)\",\n        \"shrink\": 0.75\n    },\n    edgecolor=\"black\",\n    linewidth=0.4,\n    missing_kwds={\"color\": \"lightgrey\", \"label\": \"No data\"}\n)\n\nfor _, r in basin_map.iterrows():\n    p = r.geometry.representative_point()\n    ax.text(p.x, p.y, int(r.basin_id), ha=\"center\", va=\"center\", fontsize=7)\n\n\nax.set_aspect(\"equal\")\nax.set_axis_off()\nax.set_title(\"Antarctic drainage-basin mean surface elevation change\")\n\nplt.show()","key":"x7KC2iVrfU"},{"type":"outputs","id":"6hrCWCDPT7bMCJ6kEIinG","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"91305562479e3962044af77df658297d","path":"/91305562479e3962044af77df658297d.png"},"text/plain":{"content":"<Figure size 900x800 with 2 Axes>","content_type":"text/plain"}}},"children":[],"key":"E5UIbsNR6P"}],"key":"zChh3oGtfL"}],"key":"e7u4Xh896a"}],"key":"oVYNzy4A35"},"references":{"cite":{"order":["Shepherd_2019"],"data":{"Shepherd_2019":{"label":"Shepherd_2019","enumerator":"1","doi":"10.1029/2019gl082182","html":"Shepherd, A., Gilbert, L., Muir, A. S., Konrad, H., McMillan, M., Slater, T., Briggs, K. H., Sundal, A. V., Hogg, A. E., & Engdahl, M. E. (2019). Trends in Antarctic Ice Sheet Elevation and Mass. <i>Geophysical Research Letters</i>, <i>46</i>(14), 8174–8183. <a target=\"_blank\" rel=\"noreferrer\" href=\"https://doi.org/10.1029/2019gl082182\">10.1029/2019gl082182</a>","url":"https://doi.org/10.1029/2019gl082182"}}}}}