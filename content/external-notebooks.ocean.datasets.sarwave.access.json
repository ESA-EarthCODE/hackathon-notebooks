ZbJRzcTJp"},{"type":"link","url":"https://en.wikipedia.org/wiki/Storm_Elpis","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Elpis","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"bv1zw5eal4"}],"urlSource":"https://en.wikipedia.org/wiki/Storm_Elpis","data":{"page":"Storm_Elpis","wiki":"https://en.wikipedia.org/","lang":"en"},"internal":false,"protocol":"wiki","key":"x7YwU1eyi6"},{"type":"text","value":" storm period.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"BHsjvFH9Ve"}],"key":"H4CHsDjSBI"}],"key":"ulSLv6sHml"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"urls = [\n    base + (\n        \"024/S1A_IW_WAV__2SDV_20220124T155810_20220124T155837_041605_04F2EE_8D3C_E11.SAFE/\"\n        \"l2-s1a-iw2-wav-dv-20220124t155812-20220124t155837-041605-04f2ee-e11.zarr\"\n    ),\n    base + (\n        \"025/S1A_IW_WAV__2SDV_20220125T035944_20220125T040011_041612_04F326_A959_E11.SAFE/\"\n        \"l2-s1a-iw2-wav-dv-20220125t035945-20220125t040011-041612-04f326-e11.zarr\"\n    ),\n    base + (\n        \"026/S1A_IW_WAV__2SDV_20220126T154139_20220126T154207_041634_04F3F4_D55F_E11.SAFE/\"\n        \"l2-s1a-iw2-wav-dv-20220126t154139-20220126t154207-041634-04f3f4-e11.zarr\"\n    )\n]\n\ndatasets = [ds] + [xr.open_zarr(url, group=\"intraburst\") for url in urls]\nwaves = [hs] + [d.hs_most_likely.where(d.land_flag == 0) for d in datasets[1:]]","key":"XEVJmJcpfT"},{"type":"outputs","id":"jmx8SeSUsyqlDXC_LBOKi","children":[],"key":"rwVmrMDxmO"}],"key":"nTqxwDKKWX"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Map all four scenes","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"n2dzOk7MLg"}],"identifier":"map-all-four-scenes","label":"Map all four scenes","html_id":"map-all-four-scenes","implicit":true,"key":"pCnH2cRgKr"}],"key":"b8C7XwJ5XP"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"fig, ax = plt.subplots(\n    figsize=(10, 5),\n    subplot_kw={\"projection\": ccrs.PlateCarree()},\n)\nax.set_extent([23, 37, 32.5, 39], crs=ccrs.PlateCarree())\nax.add_feature(cfeature.LAND.with_scale(\"50m\"), facecolor=\"lightgray\")\nax.coastlines(\"50m\", linewidth=0.8)\n\nfor wave in waves:\n    im = wave.plot(\n        ax=ax,\n        x=\"longitude\",\n        y=\"latitude\",\n        transform=ccrs.PlateCarree(),\n        cmap=\"viridis\",\n        vmin=0,\n        vmax=4,\n        add_colorbar=False,\n        add_labels=False,\n    )\n\nfig.colorbar(im, ax=ax, label=\"Significant wave height (m)\", pad=0.03)\nax.set_title(\"SARWAVE significant wave height — 23–26 January 2022\")\nplt.show()","key":"TV8O11XMSh"},{"type":"outputs","id":"DZmBbg1qluNmN9Q9VntG9","children":[],"key":"pGoRYypy4y"}],"key":"r2oj1iC6Vf"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compare scene statistics","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ZE9TBoKuxt"}],"identifier":"compare-scene-statistics","label":"Compare scene statistics","html_id":"compare-scene-statistics","implicit":true,"key":"Zk9iwZffai"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Compare the ocean-tile count, mean and maximum significant wave height for each acquisition.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"efUtsqN6qx"}],"key":"eWprXspjtR"}],"key":"h0kMSbR0to"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Acquisition start times come from the product metadata, in UTC.\ntimes = pd.to_datetime([d.attrs[\"start_date\"] for d in datasets])\n\nstats = pd.DataFrame({\n    \"Date UTC\": pd.to_datetime(times),\n    \"Mean Hs (m)\": [float(w.mean()) for w in waves],\n    \"Max Hs (m)\": [float(w.max()) for w in waves],\n})\n\nstats.plot(x=\"Date UTC\", marker=\"o\", ylabel=\"Hs (m)\", figsize=(8, 4))\nplt.show()","key":"kKKsF8xRZk"},{"type":"outputs","id":"4ffEaKrAxP_RyYM8tJgo7","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"a61b03b411d4764335185c308497ce6e","path":"/a61b03b411d4764335185c308497ce6e.png"},"text/plain":{"content":"<Figure size 800x400 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"pppvcbfM3V"}],"key":"aTlU17Gr7R"}],"key":"zIaqYS6ZTH"}],"key":"Glm0QznCzg"},"references":{"cite":{"order":["https://doi.org/10.12770/1b05fc41-e06e-4285-ad7b-b97f6f847e00"],"data":{"https://doi.org/10.12770/1b05fc41-e06e-4285-ad7b-b97f6f847e00":{"label":"https://doi.org/10.12770/1b05fc41-e06e-4285-ad7b-b97f6f847e00","enumerator":"1","doi":"10.12770/1B05FC41-E06E-4285-AD7B-B97F6F847E00","html":"Nouguier Frederic, Mouche Alexis, Grouazel Antoine, Febvre Quentin, Maillard Lisa, & Marquart Robin. (2024). <i>SARWAVE Sentinel-1 Experimental Dataset - Level-2 WAV</i>. IFREMER. <a target=\"_blank\" rel=\"noreferrer\" href=\"https://doi.org/10.12770/1B05FC41-E06E-4285-AD7B-B97F6F847E00\">10.12770/1B05FC41-E06E-4285-AD7B-B97F6F847E00</a>","url":"https://doi.org/10.12770/1B05FC41-E06E-4285-AD7B-B97F6F847E00"}}}}}