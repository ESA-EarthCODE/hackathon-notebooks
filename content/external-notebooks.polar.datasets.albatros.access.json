:true,"value":"gdf = gpd.read_parquet(item.assets[\"data\"].href, filesystem=fsspec.filesystem(\"https\"))","key":"E5hYVWjlzQ"},{"type":"outputs","id":"uRUWw93kspMDv7atXnFto","children":[],"key":"TxiNUdgecY"}],"key":"WfW6ONPeYD"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-15T00:32:31.830536Z","iopub.status.busy":"2026-11-15T00:32:31.830187Z","iopub.status.idle":"2026-11-15T00:32:31.833316Z","shell.execute_reply":"2026-11-15T00:32:31.832633Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"time_col = \"time\"\nvalue_col = \"tidal_elevation_prediction_m\"\n\nsource_crs = \"EPSG:4326\"\ntarget_crs = \"EPSG:3031\"\n\ngrid_size_m = 25_000  # 25 km\ntarget_date = \"2019-04-03\"","key":"bdUzTWx621"},{"type":"outputs","id":"RSGnwHgedIfoY8PplgJDB","children":[],"key":"rnLLjyqPpj"}],"key":"h4ffa93UMs"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-15T00:32:31.840610Z","iopub.status.busy":"2026-11-15T00:32:31.840454Z","iopub.status.idle":"2026-11-15T00:32:32.396132Z","shell.execute_reply":"2026-11-15T00:32:32.395360Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"# subset daily data\nstart = pd.Timestamp(target_date)\nend = start + pd.Timedelta(days=7)\n\ngdf_day = gdf.loc[\n    (gdf[time_col] >= start) &\n    (gdf[time_col] < end)\n].copy()\n\ngdf_day = gdf_day.dropna(subset=[value_col])","key":"Fy0eXSeWFn"},{"type":"outputs","id":"hGrqKcsLbN2wmKWnUFVt-","children":[],"key":"OSCO155BjV"}],"key":"Ul5FBq5bFs"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-15T00:32:32.404019Z","iopub.status.busy":"2026-11-15T00:32:32.403854Z","iopub.status.idle":"2026-11-15T00:32:33.460497Z","shell.execute_reply":"2026-11-15T00:32:33.459866Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"# reproject and regrid\ngdf_3031 = gdf_day.to_crs(target_crs)\n\nfrom shapely.geometry import box\n\nminx, miny, maxx, maxy = gdf_3031.total_bounds\n\n# Snap grid bounds to the 25 km grid\nminx = np.floor(minx / grid_size_m) * grid_size_m\nminy = np.floor(miny / grid_size_m) * grid_size_m\nmaxx = np.ceil(maxx / grid_size_m) * grid_size_m\nmaxy = np.ceil(maxy / grid_size_m) * grid_size_m\n\nx_edges = np.arange(minx, maxx + grid_size_m, grid_size_m)\ny_edges = np.arange(miny, maxy + grid_size_m, grid_size_m)\n\ngrid_cells = []\n\nfor x0 in x_edges[:-1]:\n    for y0 in y_edges[:-1]:\n        x1 = x0 + grid_size_m\n        y1 = y0 + grid_size_m\n\n        grid_cells.append(\n            {\n                \"geometry\": box(x0, y0, x1, y1),\n                \"grid_x\": x0,\n                \"grid_y\": y0\n            }\n        )\n\ngrid = gpd.GeoDataFrame(grid_cells, crs=target_crs)\n\nprint(len(grid))\ngrid.head()","key":"m7G4CRK0H5"},{"type":"outputs","id":"bEKR-dCkIWjuAr3Brv_MD","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"54516\n"},"children":[],"key":"TDuZ9lJEtk"},{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":6,"metadata":{},"data":{"text/html":{"content":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>geometry</th>\n      <th>grid_x</th>\n      <th>grid_y</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>0</th>\n      <td>POLYGON ((-2675000 -2825000, -2675000 -2800000...</td>\n      <td>-2700000.0</td>\n      <td>-2825000.0</td>\n    </tr>\n    <tr>\n      <th>1</th>\n      <td>POLYGON ((-2675000 -2800000, -2675000 -2775000...</td>\n      <td>-2700000.0</td>\n      <td>-2800000.0</td>\n    </tr>\n    <tr>\n      <th>2</th>\n      <td>POLYGON ((-2675000 -2