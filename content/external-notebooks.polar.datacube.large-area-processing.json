gEchx7Hq2QopO","children":[],"key":"rbNX4zTxtJ"}],"key":"GqcZCnnVbW"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Connect with Data Cube","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"IoL8vT27n7"}],"identifier":"connect-with-data-cube","label":"Connect with Data Cube","html_id":"connect-with-data-cube","implicit":true,"key":"rEq88gam2W"}],"key":"oBctJKO9Di"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"combined_url = \"https://s3.waw4-1.cloudferro.com/EarthCODE/OSCAssets/antarctica_cube/land-ice/antarctica-combined.zarr\"\nds = xr.open_zarr(combined_url, group=\"0\", chunks={})\nds\n","key":"EmLzAT8ywe"},{"type":"outputs","id":"zbyUm9v9unyVC57zFPY31","children":[],"key":"Ri0QWbtrez"}],"key":"dEBkCa0lAg"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"dx = abs((ds.x.isel(x=1) - ds.x.isel(x=0)).load().item())\ndy = abs((ds.y.isel(y=1) - ds.y.isel(y=0)).load().item())\nkm2 = dx * dy / 1e6\n\nds[[\n    \"mask\",\n    \"bed\",\n    \"thickness\",\n    \"errbed\",\n    \"ice_shelf_basal_melt_rate\",\n    \"groundlines_mask\",\n    \"subglacial_lakes_extents_mask\",\n    \"supra_glacial_lakes_mask\",\n]]\n","key":"G1MRMBSElU"},{"type":"outputs","id":"REaRVKIMXPGGfBNZ3NQK5","children":[],"key":"Y30b43QVXy"}],"key":"mCzV1mfRyI"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Area of the main surface classes","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ssIUH4bBRQ"}],"identifier":"area-of-the-main-surface-classes","label":"Area of the main surface classes","html_id":"area-of-the-main-surface-classes","implicit":true,"key":"QHMJbnTysm"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Mask codes: 0 ocean, 1 ice-free land, 2 grounded ice, 3 floating ice, 4 Lake Vostok.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"FcYieW0bcc"}],"key":"Um5N1WXKST"}],"key":"nfTjvFShdP"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"mask = ds[\"mask\"]\n\nsurface_area = xr.Dataset({\n    \"ocean\": (mask == 0).sum() * km2,\n    \"ice_free_land\": (mask == 1).sum() * km2,\n    \"grounded_ice\": (mask == 2).sum() * km2,\n    \"floating_ice\": (mask == 3).sum() * km2,\n    \"lake_vostok\": (mask == 4).sum() * km2,\n}).compute()\n\nsurface_area.to_array().to_series().rename(\"area_km2\").to_frame()\n","key":"pvxKOPy3kt"},{"type":"outputs","id":"5TCy7yH2gvJ4aBlNlZXes","children":[],"key":"yg3aCuaHZT"}],"key":"HQ4WhnlHCz"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Example 1: marine-based grounded ice exposure","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"hccuMZHCEo"}],"identifier":"example-1-marine-based-grounded-ice-exposure","label":"Example 1: marine-based grounded ice exposure","html_id":"example-1-marine-based-grounded-ice-exposure","implicit":true,"key":"nVlFsgEQKa"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"This estimates how much grounded ice sits on bed below sea level, including deep basins below -1000 m.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"fZY3xwxog8"}],"key":"cMJ3gMAqJi"}],"key":"K6i87qNiZo"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"bed = ds[\"bed\"]\nthickness = ds[\"thickness\"]\nerr = ds[\"errbed\"]\nmarine = (mask == 2) & (bed < 0)\n\nmarine_summary = xr.Dataset({\n    \"grounded_ice_bed_below_0m_km2\": marine.sum() * km2,\n    \"grounded_ice_bed_below_minus_1000m_km2\": (marine & (bed < -1000)).sum() * km2,\n    \"mean_bed_elevation_m\": bed.where(marine).mean(),\n    \"mean_ice_thickness_m\": thickness.where(marine).mean(),\n    \"mean_bed_error_m\": err.where(marine).mean(),\n}).compute()\n\nmarine_summary.to_array().to_series().rename(\"value\").to_frame()\n","key":"tn9Ok6qRCs"},{"type":"outputs","id":"gER1oWqzHmmKK6MFfabkR","children":[],"key":"hzGEbn39uS"}],"key":"MsJyECf4eW"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Example 2: floating-ice basal melt and a 5 km grounding-zone buffer","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"B9xqvIlGwu"}],"identifier":"example-2-floating-ice-basal-melt-and-a-5-km-grounding-zone-buffer","label":"Example 2: floating-ice basal melt and a 5 km grounding-zone buffer","html_id":"example-2-floating-ice-basal-melt-and-a-5-km-grounding-zone-buffer","implicit":true,"key":"lDK4921tpZ"}],"key":"zj7DMBaaSd"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from scipy.ndimage import binary_dilation\n\nmelt = ds[\"ice_shelf_basal_melt_rate\"]\nfloating = (mask == 3) & melt.notnull()\n\ngl5 = da.map_overlap(\n    binary_dilation,\n    ds[\"groundlines_mask\"].data.astype(bool),\n    depth=5,\n    boundary=False,\n    dtype=bool,\n    structure=np.ones((11, 11), bool),\n)\ngrounding_zone = xr.DataArray(gl5, coords=mask.coords, dims=mask.dims) & floating\n\nmelt_summary = xr.Dataset({\n    \"floating_ice_with_melt_data_km2\": floating.sum() * km2,\n    \"floating_ice_mean_melt_m\": melt.where(floating).mean(),\n    \"floating_ice_net_melt_km3_per_dataset_unit\": melt.where(floating).sum() * km2 / 1000,\n    \"grounding_zone_5km_area_km2\": grounding_zone.sum() * km2,\n    \"grounding_zone_5km_mean_melt_m\": melt.where(grounding_zone).mean(),\n}).compute()\n\nmelt_summary.to_array().to_series().rename(\"value\").to_frame()\n","key":"SLn0jpBagu"},{"type":"outputs","id":"Trg6MjL0WclGsresiFAxH","children":[],"key":"UMBTokdIuD"}],"key":"PtFUgEkzvA"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"client.close()\n","key":"Cj2tE9HWXj"},{"type":"outputs","id":"cPINJF67iBbTZR7_HSLmU","children":[],"key":"U51Q0ZFliB"}],"key":"N4dyduSs1r"}],"key":"l13hVbThmL"},"references":{"cite":{"order":[],"data":{}}}}