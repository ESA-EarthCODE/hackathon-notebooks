cute_reply":"2026-11-15T01:53:29.033428Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"start.values[0]","key":"SMCTs7bKun"},{"type":"outputs","id":"x3y89vDwm129QkI2gK6ZB","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":9,"metadata":{},"data":{"text/plain":{"content":"array([['NaT', 'NaT', 'NaT', ..., 'NaT', 'NaT', 'NaT'],\n       ['NaT', 'NaT', 'NaT', ..., 'NaT', 'NaT', 'NaT'],\n       ['NaT', 'NaT', 'NaT', ..., 'NaT', 'NaT', 'NaT'],\n       ...,\n       ['NaT', 'NaT', 'NaT', ..., 'NaT', 'NaT', 'NaT'],\n       ['NaT', 'NaT', 'NaT', ..., 'NaT', 'NaT', 'NaT'],\n       ['NaT', 'NaT', 'NaT', ..., 'NaT', 'NaT', 'NaT']],\n      shape=(63, 168), dtype='datetime64[ns]')","content_type":"text/plain"}}},"children":[],"key":"dceTwUNhjo"}],"key":"NXXoLMls1T"}],"key":"jyR6oErGbc"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-15T01:53:29.048344Z","iopub.status.busy":"2026-11-15T01:53:29.048243Z","iopub.status.idle":"2026-11-15T01:53:58.129423Z","shell.execute_reply":"2026-11-15T01:53:58.129012Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"# duration_days already contains only events starting in June\nvalid = duration_days.notnull()\n\n# First valid event index at each grid cell\nfirst = valid.argmax(dim=\"nevent\").compute()\n\n# Reduce to (lat, lon); mask cells with no matching event\nmonthly_duration = duration_days.isel(nevent=first).where(\n    valid.any(dim=\"nevent\")\n)","key":"qRTgeiM2DR"},{"type":"outputs","id":"Qdb_aRjKnu9IUsQdT-bEM","children":[],"key":"YX12ka4iut"}],"key":"Zydmlzlnz1"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-15T01:53:58.143316Z","iopub.status.busy":"2026-11-15T01:53:58.143221Z","iopub.status.idle":"2026-11-15T01:54:27.187217Z","shell.execute_reply":"2026-11-15T01:54:27.186909Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"import matplotlib.pyplot as plt\nimport cartopy.crs as ccrs\nimport cartopy.feature as cfeature\n\n\nfig, ax = plt.subplots(\n    figsize=(14, 7),\n    subplot_kw={\"projection\": ccrs.Robinson()},\n)\n\nmonthly_duration.plot.pcolormesh(\n    ax=ax,\n    x=\"lon\",\n    y=\"lat\",\n    transform=ccrs.PlateCarree(),\n    cmap=\"viridis\",\n    cbar_kwargs={\n        \"label\": \"Event duration (days)\",\n        \"shrink\": 0.7,\n    },\n)\nax.coastlines(linewidth=0.6)\nax.gridlines(linewidth=0.4, alpha=0.4)\nax.set_title(\"Duration of all events starting in May and ending before July 2020\")\nax.add_feature(cfeature.LAND, facecolor=\"lightgray\")\n","key":"IOB1z6cwtE"},{"type":"outputs","id":"2k19FxtGb6DIH31bc4PgG","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":11,"metadata":{},"data":{"text/plain":{"content":"<cartopy.mpl.feature_artist.FeatureArtist at 0x14a04afd0>","content_type":"text/plain"}}},"children":[],"key":"radxxsNAJo"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"aac436c95e22e6d78b8e52f90fabc873","path":"/aac436c95e22e6d78b8e52f90fabc873.png"},"text/plain":{"content":"<Figure size 1400x700 with 2 Axes>","content_type":"text/plain"}}},"children":[],"key":"navplmBKSd"}],"key":"Kib5buvcZq"}],"key":"Asg0lwKgF0"}],"key":"hNpvQ09J34"},"references":{"cite":{"order":[],"data":{}}}}