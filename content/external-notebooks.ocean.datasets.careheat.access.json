.88\n  * lon       (lon) float32 6kB -179.9 -179.6 -179.4 ... 179.4 179.6 179.9\nData variables:\n    category  (time, lat, lon) float32 68GB dask.array<chunksize=(30, 720, 1440), meta=np.ndarray>\nAttributes: (12/16)\n    contact:            federico.serva@terrarum.eu\n    author:             Federico Serva\n    institution:        CNR-ISMAR\n    version:            v2025a\n    date:               2025-08\n    website:            https://careheat.org/\n    ...                 ...\n    climatologyPeriod:  [1991, 2020]\n    windowHalfWidth:    5\n    pctile:             90\n    minDuration:        5\n    maxGap:             2\n    NCO:                netCDF Operators version 4.8.1 (Homepage = http://nco...","content_type":"text/plain"}}},"children":[],"key":"zPwYRzCRkl"}],"key":"KvwsNHKgIH"}],"key":"qAONfvY59r"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-15T01:52:30.742695Z","iopub.status.busy":"2026-11-15T01:52:30.742309Z","iopub.status.idle":"2026-11-15T01:52:34.367984Z","shell.execute_reply":"2026-11-15T01:52:34.367396Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"import matplotlib.pyplot as plt\nimport cartopy.crs as ccrs\nimport cartopy.feature as cfeature\nfrom matplotlib.colors import BoundaryNorm\nimport numpy as np\n\ndate = \"2020-06\"\n\n\nda = ds[\"category\"].sel(time=np.datetime64(date), lon=slice(-6.062, 36.06), lat=slice(30.27, 45.98), drop=True)\n\n# Categories present in the data\ncategories = [0, 1, 2, 3, 4]\n\n# Discrete colormap\ncmap = plt.get_cmap(\"viridis\", len(categories))\n\n# Put colour boundaries halfway between categories\nbounds = [-0.5, 0.5, 1.5, 2.5, 3.5, 4.5]\nnorm = BoundaryNorm(bounds, cmap.N)\n\nfig, ax = plt.subplots(\n    figsize=(12, 6),\n    subplot_kw={\"projection\": ccrs.PlateCarree()}\n)\n\nim = ax.pcolormesh(\n    da.lon,\n    da.lat,\n    da,\n    transform=ccrs.PlateCarree(),\n    cmap=cmap,\n    norm=norm,\n    shading=\"auto\"\n)\n\nax.coastlines()\nax.add_feature(cfeature.LAND, facecolor=\"lightgray\")\n\n\n\nlabels = [\n    \"No event\",\n    \"Moderate\",\n    \"Strong\",\n    \"Severe\",\n    \"Extreme\"\n]\n\ncbar = fig.colorbar(\n    im,\n    ax=ax,\n    ticks=[0, 1, 2, 3, 4],\n    pad=0.03\n)\n\ncbar.ax.set_yticklabels(labels)\ncbar.set_label(\"Marine Heatwaves category\")\n\nax.set_title(f\"Marine Heatwaves - {date}\")\n\nplt.show()","key":"hpSZ6ZP7n1"},{"type":"outputs","id":"knQ7O4cMC0G_O8UN2REGI","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"5ad38144c2461b936bc863fc49da4779","path":"/5ad38144c2461b936bc863fc49da4779.png"},"text/plain":{"content":"<Figure size 1200x600 with 2 Axes>","content_type":"text/plain"}}},"children":[],"key":"ZxW254E66w"}],"key":"JKbAbAerzF"}],"key":"S2G8opAYNH"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Metrics dataset","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"EeyNCAzjNN"}],"identifier":"metrics-dataset","label":"Metrics dataset","html_id":"metrics-dataset","implicit":true,"key":"YLgvbIxzlM"}],"key":"TDFd2ihgBS"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The “date_start” and “date_end” are another key part of the data.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"KzpcEyxADS"}],"key":"xYCEmGTsku"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"For example, one can compute the duration of a events at certain location by doing:","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"C67Bm9axFu"}],"key":"gb4f6jTpJR"}],"key":"rUvxF8OuSr"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-15T01:52:34.396777Z","iopub.status.busy":"2026-11-15T01:52:34.396618Z","iopub.status.idle":"2026-11-15T01:52:34.666283Z","shell.execute_reply":"2026-11-15T01:52:34.665044Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"import pandas as pd\n\nds = xr.open_zarr(items[\"careheat-database-careheat_mhw_metrics_2d\"].assets[\"data\"].href)\n\n# select all the date starts and date ends for the Med\ndstart = ds[\"date_start\"].sel(lon=slice(-6.062, 36.06), lat=slice(30.27, 45.98), drop=True)\ndend = ds[\"date_end\"].sel(lon=slice(-6.062, 36.06), lat=slice(30.27, 45.98), drop=True)","key":"nj5SYPqTpQ"},{"type":"outputs","id":"jDHMcoAuQTBNmd2rKwgPE","children":[],"key":"pZXXgYD58n"}],"key":"Q0nMD92ulr"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-15T01:52:34.701330Z","iopub.status.busy":"2026-11-15T01:52:34.701125Z","iopub.status.idle":"2026-11-15T01:52:42.741872Z","shell.execute_reply":"2026-11-15T01:52:42.741429Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"dstart.isel(nevent=0).values","key":"GhrbTkzhzx"},{"type":"outputs","id":"pl7B8QLx8mrfQpsoW_B9Q","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":6,"metadata":{},"data":{"text/plain":{"content":"array([[      nan,       nan,       nan, ...,       nan,       nan,\n              nan],\n       [      nan,       nan,       nan, ...,       nan,       nan,\n              nan],\n       [      nan,       nan,       nan, ...,       nan,       nan,\n              nan],\n       ...,\n       [19830710., 19830710., 19830713., ...,       nan, 19820101.,\n              nan],\n       [19830710., 19830710., 19830710., ..., 19820101., 19801231.,\n        19801230.],\n       [19830710., 19830710., 19830710., ..., 19810209., 19801224.,\n        19801224.]], shape=(63, 168))","content_type":"tex