20, 720), meta=np.ndarray>\n    lon              (y, x) float32 2MB dask.array<chunksize=(720, 720), meta=np.ndarray>\nDimensions without coordinates: nv\nData variables:\n    crs              int32 4B ...\n    sss              (time, y, x) float32 9GB dask.array<chunksize=(10, 720, 720), meta=np.ndarray>\n    time_bnds        (time, nv) datetime64[ns] 71kB dask.array<chunksize=(4441, 2), meta=np.ndarray>\n    uncertainty_sss  (time, y, x) float32 9GB dask.array<chunksize=(10, 720, 720), meta=np.ndarray>\nAttributes: (12/35)\n    date_created:             2023-07-12 06:14:00 GMT\n    geospatial_x_units:       m\n    geospatial_y_units:       m\n    geospatial_x_resolution:  25000.0\n    geospatial_y_resolution:  25000.0\n    geospatial_x_min:         -9000000.0\n    ...                       ...\n    copyright:                If this data is used for publication, the follo...\n    comment:                  This data was produced at BEC as part of the So...\n    time_coverage_start:      20110201T00:00:00\n    time_coverage_end:        1680217200000000000\n    DOI:                      10.20350/digitalCSIC/15493\n    title:                    Southern Ocean SMOS Level 3 Sea Surface Salinit...","content_type":"text/plain"}}},"children":[],"key":"fmrqbN3E01"}],"key":"pNsXHgmCGd"}],"key":"IdQcVJXrcV"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-15T00:42:47.165195Z","iopub.status.busy":"2026-11-15T00:42:47.164855Z","iopub.status.idle":"2026-11-15T00:42:47.173031Z","shell.execute_reply":"2026-11-15T00:42:47.172566Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"da = ds['sss']\nsubset = da.sel(\n    time=[\"2011-02-01\", \"2016-01-01\", \"2021-01-01\"],\n    method=\"nearest\"\n)","key":"Ic7UA4Pxw8"},{"type":"outputs","id":"hB7yYsJneEA72beA3eWmq","children":[],"key":"hjt8yyv4ja"}],"key":"msmM4HUe01"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-11-15T00:42:47.183020Z","iopub.status.busy":"2026-11-15T00:42:47.182927Z","iopub.status.idle":"2026-11-15T00:43:00.867427Z","shell.execute_reply":"2026-11-15T00:43:00.867057Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"vmin = subset.min(skipna=True).values\nvmax = subset.max(skipna=True).values\n\nfig, axes = plt.subplots(\n    nrows=1,\n    ncols=3,\n    figsize=(18, 6),\n    constrained_layout=True\n)\n\nfor ax, t in zip(axes, subset.time):\n    plot_data = da.sel(time=t)\n\n    im = ax.pcolormesh(\n        ds[\"x\"],\n        ds[\"y\"],\n        plot_data,\n        shading=\"auto\",\n        vmin=vmin,\n        vmax=vmax,\n        cmap=\"viridis\"\n    )\n\n    ax.set_title(f\"SSS\\n{t.dt.strftime('%Y-%m-%d %H:%M').item()}\")\n    ax.set_xlabel(\"x [m]\")\n    ax.set_ylabel(\"y [m]\")\n    ax.set_aspect(\"equal\")\n\n# shared colorbar\ncbar = fig.colorbar(im, ax=axes, orientation=\"vertical\", shrink=0.8)\ncbar.set_label(\"Sea Surface Salinity\")\n\nplt.show()","key":"KftFBUxDZD"},{"type":"outputs","id":"A2hKfu0PRb8PwOqYwVyKq","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"af11e24ccf5096a0d2507fc9adaf4916","path":"/hackathon-notebooks/build/af11e24ccf5096a0d2507fc9adaf4916.png"},"text/plain":{"content":"<Figure size 1800x600 with 4 Axes>","content_type":"text/plain"}}},"children":[],"key":"tZwFMghIgg"}],"key":"NGDUpHzHrw"}],"key":"WL9AUBzX5Y"}],"key":"g7vPkqSEWi"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Surface Elevation Change","url":"/external-notebooks/polar/datasets/sec/access","group":"Sec"},"next":{"title":"Subglacial Lakes","url":"/external-notebooks/polar/datasets/subglacial-lakes/access","group":"Subglacial Lakes"}}},"domain":"http://localhost:3000"}