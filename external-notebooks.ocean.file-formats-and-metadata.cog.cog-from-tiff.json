he COG","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"pYCxS8ekwe"}],"identifier":"write-the-cog","label":"Write The COG","html_id":"write-the-cog","implicit":true,"key":"lKTqkYJa8h"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"inlineCode","value":"driver=\"COG\"","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"hmVLe2DHMH"},{"type":"text","value":" asks GDAL/rasterio to create a cloud-optimized layout. Compression reduces object-store transfer size; 512-pixel blocks are a common starting point for analytical rasters.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"sKNUQBi4iR"}],"key":"n22FOEmhNo"}],"key":"ivxATBOTAw"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"COG_OPTIONS = {\n    \"driver\": \"COG\",\n    \"compress\": \"DEFLATE\",\n    \"blocksize\": 512,\n    \"overview_resampling\": \"nearest\",\n    \"BIGTIFF\": \"IF_SAFER\",\n}\n\nda.rio.to_raster(OUTPUT_FILE, **COG_OPTIONS)\nprint(f\"Wrote {OUTPUT_FILE}\")\nprint(f\"Source size: {INPUT_FILE.stat().st_size / 1024**2:.1f} MiB\")\nprint(f\"COG size:    {OUTPUT_FILE.stat().st_size / 1024**2:.1f} MiB\")\n","key":"Ferrzo7rP2"},{"type":"outputs","id":"pllTgnNLdFLCKUGrvqZi1","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Wrote /home/krasen/hackathon-repo/downloaded_data/basal_melt_map_racmo_firn_air_corrected_cog.tif\nSource size: 150.3 MiB\nCOG size:    7.4 MiB\n"},"children":[],"key":"QaLpkNCmO9"}],"key":"C22VbF0qu7"}],"key":"NFvdRZU9UB"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"validate_cog(OUTPUT_FILE)\n","key":"eCuXvYw3eF"},{"type":"outputs","id":"YDDWYJ2pydLA3qKEeIgfj","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"/home/krasen/hackathon-repo/downloaded_data/basal_melt_map_racmo_firn_air_corrected_cog.tif is a valid cloud optimized GeoTIFF\n\n"},"children":[],"key":"Rpp2H18T9L"}],"key":"MEPqJaoWaX"}],"key":"WknWA3w2I2"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import rioxarray\nimport rasterio\nimport matplotlib.pyplot as plt\nimport cartopy.crs as ccrs\nimport cartopy.feature as cfeature\n\n# 1. Define the path to your saved COG\ncog_path = OUTPUT_FILE\n\nwith rasterio.open(cog_path) as src:\n    overviews = src.overviews(1)\n    num_overviews = len(overviews)\n\nprint(f\"Total overview levels found: {num_overviews}\")\n\n# 3. Calculate First, Middle, and Last indices\n# rioxarray uses 0-based indexing for overviews\nfirst_level = 0\nmiddle_level = num_overviews // 2\nlast_level = num_overviews - 1\n\nlevels_to_plot = [\n    (\"First (Highest Res Overview)\", first_level),\n    (\"Middle Overview\", middle_level),\n    (\"Last (Lowest Res Overview)\", last_level)\n]\n\n# 4. Set up a 1x3 matplotlib figure with Cartopy projections\nproj = ccrs.SouthPolarStereo()\nfig, axes = plt.subplots(1, 3, figsize=(18, 6), subplot_kw={'projection': proj})\n\n# 5. Loop through our chosen levels and axes\nfor ax, (title_label, level_idx) in zip(axes, levels_to_plot):\n    \n    # Load just this specific overview level into memory\n    da_overview = rioxarray.open_rasterio(\n        cog_path, \n        overview_level=level_idx, \n        masked=True\n    ).sel(band=1)\n    \n    # Set up map extent and basemap features\n    ax.set_extent([-180, 180, -90, -60], ccrs.PlateCarree())\n    ax.add_feature(cfeature.LAND, facecolor='lightgray', zorder=0)\n    ax.add_feature(cfeature.OCEAN, facecolor='aliceblue', zorder=0)\n    ax.coastlines(resolution='50m', color='black', linewidth=1, zorder=2)\n    ax.gridlines(draw_labels=True, color='gray', alpha=0.5, linestyle='--')\n    \n    # Plot the data onto the current axis\n    da_overview.plot.pcolormesh(\n        ax=ax,\n        x='x',\n        y='y',\n        transform=proj,\n        cmap='inferno',\n        zorder=1, \n        cbar_kwargs={\n            'orientation': 'horizontal',\n            'shrink': 0.8,\n            'label': 'Basal melt' if ax == axes[1] else '' # Only label middle colorbar to save space\n        }\n    )\n    \n    # Update the title with dynamic shape information\n    shape_str = f\"{da_overview.shape[0]}x{da_overview.shape[1]}\"\n    ax.set_title(f\"{title_label}\\nLevel: {level_idx} | Shape: {shape_str}\", fontsize=12)\n\nplt.suptitle(\"COG Pyramid Exploration: Resolution vs. Overview Level\", fontsize=16, y=1.05)\nplt.tight_layout()\nplt.show()\n","key":"CKArA6IODE"},{"type":"outputs","id":"pjU1ioX6Vzjci1l8ATDlL","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Total overview levels found: 4\n"},"children":[],"key":"HBJX9MLlUF"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"8da7de4097cea21fb5df8df4d22ecfc3","path":"/hackathon-notebooks/build/8da7de4097cea21fb5df8df4d22ecfc3.png"},"text/plain":{"content":"<Figure size 1800x600 with 6 Axes>","content_type":"text/plain"}}},"children":[],"key":"w64C3cw5cx"}],"key":"DZM5WYKoPn"}],"key":"D6Q903oGa0"}],"key":"PQIUIObyj0"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Create COGs From A Curvilinear NetCDF","url":"/external-notebooks/ocean/file-formats-and-metadata/cog/cog-from-nc","group":"Cog"},"next":{"title":"Build STAC Metadata For A COG","url":"/external-notebooks/ocean/file-formats-and-metadata/cog/cog-metadata","group":"Cog"}}},"domain":"http://localhost:3000"}