(fronts.geometry.iloc[-1])\nzoom = max(getattr(changed, \"geoms\", [changed]), key=lambda geom: geom.area)\nxmin, ymin, xmax, ymax = zoom.bounds\npad = max(xmax - xmin, ymax - ymin) * 0.25\n\nax = fronts.plot(\n    column=\"year\",\n    cmap=\"plasma\",\n    alpha=0.12,\n    edgecolor=\"black\",\n    linewidth=1,\n    legend=True,\n    figsize=(8, 8),\n)\n\nax.set_xlim(xmin - pad, xmax + pad)\nax.set_ylim(ymin - pad, ymax + pad)\nax.set(title=\"Polygon shrinkage through time\", aspect=\"equal\")\nax.set_axis_off()\nplt.show()","key":"bxYWU3kBHV"},{"type":"outputs","id":"aKh_I__Qxq0jbCXKppACw","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"c8d9752c6bc319557f07fc7d198ca95f","path":"/hackathon-notebooks/build/c8d9752c6bc319557f07fc7d198ca95f.png"},"text/plain":{"content":"<Figure size 800x800 with 2 Axes>","content_type":"text/plain"}}},"children":[],"key":"J4nUOz3knG"}],"key":"whk0z6WTft"}],"key":"XcPCS3RDge"}],"key":"RCbwZWehzx"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"BedMachine Antarctica","url":"/external-notebooks/polar/datasets/bedrock-topography/access","group":"Bedrock Topography"},"next":{"title":"CS+AO Sea Ice Thickness","url":"/external-notebooks/polar/datasets/csao/access","group":"Csao"}}},"domain":"http://localhost:3000"}