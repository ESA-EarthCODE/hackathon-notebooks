e":2,"column":1},"end":{"line":2,"column":1}},"key":"pNAXCDgKOJ"},{"type":"inlineCode","value":"pystac","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"cK7TFATyQP"},{"type":"text","value":" for building the metadata standard.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"QXhWNFPRTQ"}],"key":"rtof1kTC8s"}],"key":"RCVgg8MdPA"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import geopandas as gpd\nfrom sqlalchemy import create_engine, inspect, text\nfrom geoalchemy2 import Geometry\nimport pandas as pd\nimport pyarrow.parquet as pq\nimport time\nimport requests\nfrom pystac import Collection, Extent, SpatialExtent, TemporalExtent, Link, Item\nfrom datetime import datetime, timezone\nfrom shapely.geometry import box, mapping\nimport os","key":"okUokoV0vK"},{"type":"outputs","id":"Gi11aPYVBWJtgP8LbeMNs","children":[],"key":"uSqcRhmMXb"}],"key":"N03zquRhkt"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"We read environment variables to configure our connection to the ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"C3lqdaKLxg"},{"type":"inlineCode","value":"eoAPI","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"JCbtyWclTA"},{"type":"text","value":" PostGIS database and define the target STAC API URLs and collection IDs.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"b1tybNS2W1"}],"key":"kJerSFhqPy"}],"key":"AQOKciLQBz"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Configuration\nuser = os.getenv(\"eoapi-db_user\")\npassword = os.getenv(\"eoapi-db_password\")\nhost = os.getenv(\"eoapi-db_host\")\nport = os.getenv(\"eoapi-db_port\")\ndatabase = os.getenv(\"eoapi-db_dbname\")\n\nengine = create_engine(f\"postgresql://{user}:{password}@{host}:{port}/{database}\")\ninspector = inspect(engine)\n\nSTAC_API_URL = \"http://eoapi-rw-stac:8080\" \nVECTOR_SOURCE_URL = \"https://data.statistik.gv.at/data/OGDEXT_NUTS_1_STATISTIK_AUSTRIA_NUTS3_20200101.zip\"\nFILE_PATH = f\"{os.getenv('HOME')}/bucket/samples/OGDEXT_NUTS_1_STATISTIK_AUSTRIA_NUTS3_20200101.zip\"\nCOLLECTION_ID = \"demo_vector\"\nSTYLE_URL = \"https://raw.githubusercontent.com/eoxhub-workspaces/eoxhub-notebooks/refs/heads/main/assets/vector_style.json\"\n","key":"tD6jMqDqrG"},{"type":"outputs","id":"wjtmkG6hmsvYNHmFzuQJs","children":[],"key":"umGIsbYMM4"}],"key":"Vo7siUlOrh"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"2. Download Sample Vector Data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"FuAbmHFfD9"}],"identifier":"id-2-download-sample-vector-data","label":"2. Download Sample Vector Data","html_id":"id-2-download-sample-vector-data","implicit":true,"key":"kawhmhrLzw"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Here we download a sample zipped shapefile (Austrian NUTS3 regions). If the file already exists in the mounted bucket, it skips the download to save time.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"Qa5Q8ZxnxI"}],"key":"fIm5N0PuVC"}],"key":"ByoghxUHbV"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# First we download the example vector file and put it into the mounted bucket\n# You can also use the File Browser to upload your data\n# (should be used for files smaller then 1 GB)\nif os.path.exists(FILE_PATH):\n    print(f\"File exists at {FILE_PATH}. Skipping.\")\nelse:\n    print(f\"Downloading to {FILE_PATH}...\")\n    with requests.get(VECTOR_SOURCE_URL, stream=True) as r:\n        r.raise_for_status()\n        with open(FILE_PATH, 'wb') as f:\n            for chunk in r.iter_content(chunk_size=8192):\n                f.write(chunk)\n    print(f\"Download finished\")","key":"wXc6UFqVQb"},{"type":"outputs","id":"pB8xcKrviiSox3L1Ifgwo","children":[],"key":"TtSxvksdPS"}],"key":"jHFp6XZSs7"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"3. Process and Ingest Data into PostGIS","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"q5xvXBnQ5x"}],"identifier":"id-3-process-and-ingest-data-into-postgis","label":"3. Process and Ingest Data into PostGIS","html_id":"id-3-process-and-ingest-data-into-postgis","implicit":true,"key":"mi6Z1UFP5j"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"We load the downloaded shapefile using GeoPandas. Because TiPg (the vector tile engine in eoAPI) works best with lowercase column names and standardized projections, we clean the columns and reproject the geometries to EPSG:4326 (WGS84) before pushing it directly to the PostGIS database.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"MsyvgM8sXR"}],"key":"l0Y2GesUUw"}],"key":"EIJHHchjCz"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"TiPG schema requirements","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"AQZ9YcAHnC"}],"identifier":"tipg-schema-requirements","label":"TiPG schema requirements","html_id":"tipg-schema-requirements","implicit":true,"key":"HRGVYcMPb4"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"TiPG has stricter schema requirements than regular PostGIS. When preparing a table for ingestion, keep the following constraints in mind:","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Wc3bauz2Nv"}],"key":"t7BY9JAtn7"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":5,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Column names must be lowercase.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"xpHMV9DmYl"}],"key":"o63abvk85v"}],"key":"Y2VGEImSOI"},{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The table must contain a column named ","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"ONr5A1RRcB"},{"type":"inlineCode","value":"id","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"fHiMJUkDXl"},{"type":"text","value":".","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"xXXP3JX3We"}],"key":"veqecxXTBa"}],"key":"OGUWZF9tXy"},{"type":"listItem","spread":true,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Column names must not end with a digit. Digits elsewhere in the column name are allowed.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"zXxmETjWo3"}],"key":"N9AACy5JOx"}],"key":"DYaQKvp1v1"}],"key":"qFmkbyVDXO"}],"key":"kI2f29RdF0"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Load zipped shapefile in this case, most other vector formats should work\n# like geojson, (geo)parquet, flatgebuf\n\ngdf = gpd.read_file(FILE_PATH)\n# in this step we make sure column names are set lower case as this can create issues with TiPg\ngdf.columns = [c.lower() for c in gdf.columns]\n\n# Ensure it is in WGS84 for STAC compliance\nif gdf.crs and not gdf.crs.is_geographic:\n    gdf = gdf.to_crs(epsg=4326)\n\n# Insert into TiPg (eoAPI) database using GeoPandas to_postgis \ngdf.to_postgis(\n    name=COLLECTION_ID,\n    con=engine,\n    if_exists=\"replace\",\n    index=False,\n    dtype={\"geometry\": Geometry(\"GEOMETRY\", srid=4326)}\n)","key":"lhBlbaEA6m"},{"type":"outputs","id":"rKb6aqr7Rl9j-f_LJ9-rc","children":[],"key":"DeEwvF9ske"}],"key":"TnopRyrAPV"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# We can have a quick look at the created db table\ncolumns = inspector.get_columns(COLLECTION_ID)\nfor column in columns:\n    print(f\"Column name: {column['name']}, Type: {column['type']}\")","key":"UrykuOQ2nn"},{"type":"outputs","id":"kgPDuYmn72bs-QmraHaPF","children":[],"key":"nLzIH9IshN"}],"key":"ofbZBuRBA9"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"4. Create a STAC Collection","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Y9D87dINf4"}],"identifier":"id-4-create-a-stac-collection","label":"4. Create a STAC Collection","html_id":"id-4-create-a-stac-collection","implicit":true,"key":"XepUjnwiBZ"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Before we can register the individual vector item, we need a Collection to hold it. We check if ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"Bv5JhnlxCA"},{"type":"inlineCode","value":"demo_vector","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"NwiHfLwi0f"},{"type":"text","value":" already exists. If not, we define its metadata (like spatial and temporal extents) and create it via a POST request to the STAC API.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"kQYoTwDZFx"}],"key":"sAx5EBKDQu"}],"key":"iX6psobuY4"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Now we create the collection that will point to the vector tiles (only if it does not already exist)\ncheck_url = f\"{STAC_API_URL}/collections/{COLLECTION_ID}\"\nresp = requests.get(check_url)\nif resp.status_code == 200:\n    print(f\"Collection '{COLLECTION_ID}' exists.\")\nelse:\n    print(f\"Creating collection '{COLLECTION_ID}'...\")\n    coll = Collection(\n        id=COLLECTION_ID,\n        title=\"Demo Vector Collection\",\n        description=\"Demo to show loading of vector data into eoAPI\",\n        extent=Extent(SpatialExtent([[-180, -90, 180, 90]]), TemporalExtent([[datetime(2020,1,1,tzinfo=timezone.utc), None]])),\n        license=\"CC-BY-4.0\"\n    )\n    # Sending a POST request with the Collection json to create the collection\n    resp = requests.post(f\"{STAC_API_URL}/collections\", json=coll.to_dict())\n\n    if resp.ok: # You can also use: if resp.status_code in [200, 201]:\n        print(f\"Success! Collection '{COLLECTION_ID}' created.\")\n    else:\n        print(f\"Failed with status {resp.status_code}.\")\n        print(f\"Error details: {resp.text}\")","key":"RrdjfDeXm1"},{"type":"outputs","id":"y5I6_k7hHt3nfMWAahX1W","children":[],"key":"xjekjXzhtN"}],"key":"ujdTRlpD2y"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# If we wanted to delete the collection we could use following command\n# requests.delete(f\"{STAC_API_URL}/collections/{COLLECTION_ID}\")","key":"PCBw5CJcrF"},{"type":"outputs","id":"FPBBnbcZqikhH6OK2IxIC","children":[],"key":"k2mGa7gkLv"}],"key":"o2lnwnXaem"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"5. Generate the STAC Item","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"kUJjwwzZFA"}],"identifier":"id-5-generate-the-stac-item","label":"5. Generate the STAC Item","html_id":"id-5-generate-the-stac-item","implicit":true,"key":"TTKUfgIkvf"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"We create a STAC Item to represent our dataset. Because this is vector data served as tiles, we don’t need to embed the full complex geometry in the STAC Item; the bounding box (bbox) is sufficient.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"nFsKxHfg2S"}],"key":"NLrBu6yy8u"},{"type":"paragraph","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"We also add two critical ","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"jMBJNINazT"},{"type":"inlineCode","value":"pystac.Link","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"NbpcNb50Qz"},{"type":"text","value":" objects here:","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"tcekQ3kh0J"}],"key":"oLY6XgDJFZ"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":5,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"A ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"agZrB9lP2u"},{"type":"strong","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Vector Tile Link","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"fFWtwfUI73"}],"key":"hic9wUfDk0"},{"type":"text","value":" (","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"tEiYGbYOn7"},{"type":"inlineCode","value":"application/vnd.mapbox-vector-tile","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"XOqLjsHMUd"},{"type":"text","value":") pointing to our TiPg endpoint.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"a5DToASz2B"}],"key":"l7K5FFpRCR"}],"key":"sZBYiLcBQE"},{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"A ","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"IT7o7WKj6G"},{"type":"strong","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"Style Link","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"qpHY7k0DzI"}],"key":"aAJWdgWcae"},{"type":"text","value":" (","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"aUEHjv7McT"},{"type":"inlineCode","value":"text/vector-styles","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"nUeYJgji6R"},{"type":"text","value":") that provides a JSON style spec so frontends know how to color and render the vectors.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"mupEy6Pq7q"}],"key":"OloKw4Y8b6"}],"key":"lvtmwVTRAG"}],"key":"FxXAEOLqW8"}],"key":"ylOyxqip6U"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# We need a STAC item definition in order to register it into the collection\n# see https://github.com/radiantearth/stac-spec/blob/master/item-spec/item-spec.md for further details\n\n# Extract Bounding Box (West, South, East, North)\nbbox = list(gdf.total_bounds) # [minx, miny, maxx, maxy]\ngeom_poly = box(*bbox)\n# Create geometry based on bbox\ngeometry_dict = mapping(geom_poly)\n\n# Create the STAC Item\nitem = Item(\n    id=\"vector_tiles_item\",\n    geometry=geometry_dict,\n    bbox=bbox,\n    datetime=datetime.utcnow(), # Or extract from file attributes if available\n    properties={},\n    collection=COLLECTION_ID\n)\n\n# Add preview link to allow rendering data in eoAPI GUI\neoapi_vector_endpoint = os.getenv(\"RASTER_ENDPOINT\", \"\").replace(\"raster\", \"vector\")\n\nvector_tiles = (\n    f\"{eoapi_vector_endpoint}/collections/public.{COLLECTION_ID}/tiles/WebMercatorQuad/{{z}}/{{x}}/{{y}}\"\n)\n\nvt_link = Link(\n    rel=\"vector-tile\",\n    target=vector_tiles,\n    title=COLLECTION_ID,\n    media_type=\"application/vnd.mapbox-vector-tile\",\n    extra_fields={\n        \"key\": COLLECTION_ID  # This moves the 'key' into the JSON properties\n    }\n)\nitem.add_link(vt_link)\n\nstyle_link = Link(\n    rel=\"style\",\n    target=STYLE_URL,\n    media_type=\"text/vector-styles\",\n    extra_fields={\n        \"links:keys\": [COLLECTION_ID]\n    }\n)\nitem.add_link(style_link)\n","key":"Y64UkfCh2C"},{"type":"outputs","id":"YOLcW22NJIn6jbZb3SVDu","children":[],"key":"MCkHuxjS78"}],"key":"nFgTpDxY0q"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Helper to print item to see if everything is good to go\n# item.to_dict()","key":"Me3Z3UtT8E"},{"type":"outputs","id":"cSAS4E3eFbnwHiHs44ysg","children":[],"key":"xW86SMOAKc"}],"key":"HPk4aFObpZ"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"6. Publish the STAC Item","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"sy9z6dP6tR"}],"identifier":"id-6-publish-the-stac-item","label":"6. Publish the STAC Item","html_id":"id-6-publish-the-stac-item","implicit":true,"key":"sSQc3VM1fC"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"With our STAC Item fully assembled and validated, we serialize it to a dictionary and POST it to the ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"LCZLf4ocsx"},{"type":"inlineCode","value":"eoAPI","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"vbNWI720lB"},{"type":"text","value":" STAC ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"jvnfRJuxDK"},{"type":"inlineCode","value":"/items","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"mypbxt7eq6"},{"type":"text","value":" endpoint.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"qD4QEEbZUx"}],"key":"IeHtVDDzAN"}],"key":"GHWebUV09w"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Now that the item was created we can pass it to eoAPI for ingestion\n\nurl = f\"{STAC_API_URL}/collections/{COLLECTION_ID}/items\"\nresponse = requests.post(url, json=item.to_dict())\n\nif response.status_code in [200, 201]:\n    print(\"Successfully posted STAC Item.\")\nelse:\n    print(f\"Error {response.status_code}: {response.text}\")","key":"lzYTxOh3Ti"},{"type":"outputs","id":"J9JcoSrlsuNkocZ8N7Ab_","children":[],"key":"rnvSFSKxZ8"}],"key":"yfb71vNDxf"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"7. Update Collection Extents","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"mtX8o7mQgp"}],"identifier":"id-7-update-collection-extents","label":"7. Update Collection Extents","html_id":"id-7-update-collection-extents","implicit":true,"key":"UOGMXPrlKW"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Finally, we run a utility function to fetch the items back from the collection, calculate their total spatial and temporal coverage, and patch the parent Collection. This ensures that web catalogs display the correct overview bounds.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"nSEsRrJqoq"}],"key":"iumAgFxZ9E"}],"key":"KbW6j5cmOd"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Update temporal and spatial extent based on ingested datasets\nimport requests\n\ndef update_stac(url, cid):\n    # 1. Fetch all items (limited to 1000 for brevity)\n    items = requests.get(f\"{url}/collections/{cid}/items?limit=1000\").json()['features']\n    \n    # 2. Extract and calculate (flatten coordinates and collect dates)\n    coords = [pt for f in items for pt in f['geometry']['coordinates'][0]]\n    dts = [f['properties']['datetime'] for f in items]\n    \n    # 3. Patch the collection\n    ext = {\n        \"spatial\": {\"bbox\": [[min(c[0] for c in coords), min(c[1] for c in coords), \n                             max(c[0] for c in coords), max(c[1] for c in coords)]]},\n        \"temporal\": {\"interval\": [[min(dts), max(dts)]]}\n    }\n    \n    r = requests.patch(f\"{url}/collections/{cid}\", json={\"extent\": ext})\n    print(\"Updated\" if r.ok else f\"Error: {r.text}\")\n\nupdate_stac(STAC_API_URL, COLLECTION_ID)","key":"Q4NpQUu6b6"},{"type":"outputs","id":"raVtMqWMo9uxEvBqThTOF","children":[],"key":"C6AzdgBQfz"}],"key":"jtFR5cTgDr"}],"key":"OzWHDG94kf"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"eoAPI Timeseries Ingestion and Registration Example","url":"/external-notebooks/eoxhub/notebooks/eoapi/eoapi-timeseries-registration","group":"EoAPI"},"next":{"title":"MLflow connection examples","url":"/external-notebooks/eoxhub/notebooks/mlflow/mlflow-examples","group":"Mlflow"}}},"domain":"http://localhost:3000"}