nax.set_title(f\"SARWAVE significant wave height — {date}\")\nplt.show()","key":"NxC93zg5Qe"},{"type":"outputs","id":"DnEgJZ_O-puhPvOOqygqU","children":[],"key":"mImXMRK13Z"}],"key":"cFCNAcODki"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Scene statistics","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"nLqUMg5sOg"}],"identifier":"scene-statistics","label":"Scene statistics","html_id":"scene-statistics","implicit":true,"key":"TvRr08PlvR"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Summarise significant wave height over the retained ocean tiles. Missing values are excluded.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"zLhMv8qn4k"}],"key":"p2Xt9wYBej"}],"key":"ae7bWsRCfg"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"hs.to_series().describe().round(2)","key":"MfuQnf2ZQt"},{"type":"outputs","id":"k-jNGZdME-J868ccZYBcP","children":[],"key":"WfnLfQQILc"}],"key":"Oyi29gX7YE"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Open more scenes","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Zz4pjA7tok"}],"identifier":"open-more-scenes","label":"Open more scenes","html_id":"open-more-scenes","implicit":true,"key":"tydJFJrhnu"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"Add one overpass from each of the next three days. Each scene has its own tile grid and footprint, so keep the datasets in a list.\nOverpasses during the ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"AbmSCLdCdU"},{"type":"link","url":"https://en.wikipedia.org/wiki/Storm_Elpis","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Elpis","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"wxGhGdVCOc"}],"urlSource":"https://en.wikipedia.org/wiki/Storm_Elpis","data":{"page":"Storm_Elpis","wiki":"https://en.wikipedia.org/","lang":"en"},"internal":false,"protocol":"wiki","key":"TJ9bs4GZ4o"},{"type":"text","value":" storm period.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"oLfOYGkuAw"}],"key":"q8V9rbzk9B"}],"key":"FtlPSpsTFk"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"urls = [\n    base + (\n        \"024/S1A_IW_WAV__2SDV_20220124T155810_20220124T155837_041605_04F2EE_8D3C_E11.SAFE/\"\n        \"l2-s1a-iw2-wav-dv-20220124t155812-20220124t155837-041605-04f2ee-e11.zarr\"\n    ),\n    base + (\n        \"025/S1A_IW_WAV__2SDV_20220125T035944_20220125T040011_041612_04F326_A959_E11.SAFE/\"\n        \"l2-s1a-iw2-wav-dv-20220125t035945-20220125t040011-041612-04f326-e11.zarr\"\n    ),\n    base + (\n        \"026/S1A_IW_WAV__2SDV_20220126T154139_20220126T154207_041634_04F3F4_D55F_E11.SAFE/\"\n        \"l2-s1a-iw2-wav-dv-20220126t154139-20220126t154207-041634-04f3f4-e11.zarr\"\n    )\n]\n\ndatasets = [ds] + [xr.open_zarr(url, group=\"intraburst\") for url in urls]\nwaves = [hs] + [d.hs_most_likely.where(d.land_flag == 0) for d in datasets[1:]]","key":"ZbY4ZV9s9J"},{"type":"outputs","id":"IlDCC32Hvu3Y5lstUWFaV","children":[],"key":"L9RaN7BOHJ"}],"key":"oP3UAgqlwE"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Map all four scenes","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"SjtCsQNzZA"}],"identifier":"map-all-four-scenes","label":"Map all four scenes","html_id":"map-all-four-scenes","implicit":true,"key":"b58WxZSeKC"}],"key":"fMngIwehg1"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"fig, ax = plt.subplots(\n    figsize=(10, 5),\n    subplot_kw={\"projection\": ccrs.PlateCarree()},\n)\nax.set_extent([23, 37, 32.5, 39], crs=ccrs.PlateCarree())\nax.add_feature(cfeature.LAND.with_scale(\"50m\"), facecolor=\"lightgray\")\nax.coastlines(\"50m\", linewidth=0.8)\n\nfor wave in waves:\n    im = wave.plot(\n        ax=ax,\n        x=\"longitude\",\n        y=\"latitude\",\n        transform=ccrs.PlateCarree(),\n        cmap=\"viridis\",\n        vmin=0,\n        vmax=4,\n        add_colorbar=False,\n        add_labels=False,\n    )\n\nfig.colorbar(im, ax=ax, label=\"Significant wave height (m)\", pad=0.03)\nax.set_title(\"SARWAVE significant wave height — 23–26 January 2022\")\nplt.show()","key":"Bajh7a9tx1"},{"type":"outputs","id":"MroYw3G9bdHGlxPXdyPMw","children":[],"key":"U2vPfZiMf0"}],"key":"lmX7bUHfkg"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compare scene statistics","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"fDLJrQmnTF"}],"identifier":"compare-scene-statistics","label":"Compare scene statistics","html_id":"compare-scene-statistics","implicit":true,"key":"pGcDrwoZvk"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Compare the ocean-tile count, mean and maximum significant wave height for each acquisition.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"CbVblWoV4k"}],"key":"JCj7aMmV5E"}],"key":"Tcefl2ZBmw"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Acquisition start times come from the product metadata, in UTC.\ntimes = pd.to_datetime([d.attrs[\"start_date\"] for d in datasets])\n\nstats = pd.DataFrame({\n    \"Date UTC\": pd.to_datetime(times),\n    \"Mean Hs (m)\": [float(w.mean()) for w in waves],\n    \"Max Hs (m)\": [float(w.max()) for w in waves],\n})\n\nstats.plot(x=\"Date UTC\", marker=\"o\", ylabel=\"Hs (m)\", figsize=(8, 4))\nplt.show()","key":"tuaRHLWpun"},{"type":"outputs","id":"UNaLdRhGK07g3zmXA2Gvq","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"a61b03b411d4764335185c308497ce6e","path":"/hackathon-notebooks/build/a61b03b411d4764335185c308497ce6e.png"},"text/plain":{"content":"<Figure size 800x400 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"auF4SyrXo2"}],"key":"nDFK3vBdPl"}],"key":"QOT6W4OIqZ"}],"key":"OOva5pNCVV"},"references":{"cite":{"order":["https://doi.org/10.12770/1b05fc41-e06e-4285-ad7b-b97f6f847e00"],"data":{"https://doi.org/10.12770/1b05fc41-e06e-4285-ad7b-b97f6f847e00":{"label":"https://doi.org/10.12770/1b05fc41-e06e-4285-ad7b-b97f6f847e00","enumerator":"1","doi":"10.12770/1B05FC41-E06E-4285-AD7B-B97F6F847E00","html":"Nouguier Frederic, Mouche Alexis, Grouazel Antoine, Febvre Quentin, Maillard Lisa, & Marquart Robin. (2024). <i>SARWAVE Sentinel-1 Experimental Dataset - Level-2 WAV</i>. IFREMER. <a target=\"_blank\" rel=\"noreferrer\" href=\"https://doi.org/10.12770/1B05FC41-E06E-4285-AD7B-B97F6F847E00\">10.12770/1B05FC41-E06E-4285-AD7B-B97F6F847E00</a>","url":"https://doi.org/10.12770/1B05FC41-E06E-4285-AD7B-B97F6F847E00"}}}},"footer":{"navigation":{"prev":{"title":"Access OceanSODA-ETHZ","url":"/external-notebooks/ocean/datasets/ocean-soda/access","group":"Ocean Soda"},"next":{"title":"Access Scope","url":"/external-notebooks/ocean/datasets/scope/access","group":"Scope"}}},"domain":"http://localhost:3000"}