nax.set_title(f\"SARWAVE significant wave height — {date}\")\nplt.show()","key":"Qn0dxpWpcn"},{"type":"outputs","id":"HTtFVwiPzmlBup2yBKgvA","children":[],"key":"aso8fchY1F"}],"key":"J3Bt2JwFzl"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Scene statistics","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Ei9VvMhvxd"}],"identifier":"scene-statistics","label":"Scene statistics","html_id":"scene-statistics","implicit":true,"key":"HNQOKJ7E0a"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Summarise significant wave height over the retained ocean tiles. Missing values are excluded.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"RDnfJUrLzn"}],"key":"qDymu6o8Ce"}],"key":"ITwzQbCmbs"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"hs.to_series().describe().round(2)","key":"dGAzFZDohe"},{"type":"outputs","id":"09H9Yyb-sOHbadShdginM","children":[],"key":"x3KRpqWLWf"}],"key":"Oe4LDARmXN"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Open more scenes","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"uqgOdBMxTl"}],"identifier":"open-more-scenes","label":"Open more scenes","html_id":"open-more-scenes","implicit":true,"key":"ZaahbE8YRV"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"Add one overpass from each of the next three days. Each scene has its own tile grid and footprint, so keep the datasets in a list.\nOverpasses during the ","position":{"start":{"line":3,"column":1},"end":{"lin