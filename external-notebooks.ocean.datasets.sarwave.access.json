p-all-four-scenes","label":"Map all four scenes","html_id":"map-all-four-scenes","implicit":true,"key":"Ce23fwOIbV"}],"key":"HOcaSCODHX"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"fig, ax = plt.subplots(\n    figsize=(10, 5),\n    subplot_kw={\"projection\": ccrs.PlateCarree()},\n)\nax.set_extent([23, 37, 32.5, 39], crs=ccrs.PlateCarree())\nax.add_feature(cfeature.LAND.with_scale(\"50m\"), facecolor=\"lightgray\")\nax.coastlines(\"50m\", linewidth=0.8)\n\nfor wave in waves:\n    im = wave.plot(\n        ax=ax,\n        x=\"longitude\",\n        y=\"latitude\",\n        transform=ccrs.PlateCarree(),\n        cmap=\"viridis\",\n        vmin=0,\n        vmax=4,\n        add_colorbar=False,\n        add_labels=False,\n    )\n\nfig.colorbar(im, ax=ax, label=\"Significant wave height (m)\", pad=0.03)\nax.set_title(\"SARWAVE significant wave height — 23–26 January 2022\")\nplt.show()","key":"WCus5atOvH"},{"type":"outputs","id":"JVzRn7pRrKCa91_TAIoT3","children":[],"key":"KsuZlUJraN"}],"key":"kYhojj5cZt"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compare scene statistics","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"iHAzqh1a8s"}],"identifier":"compare-scene-statistics","label":"Compare scene statistics","html_id":"compare-scene-statistics","implicit":true,"key":"SWMWitdPTc"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Compare the ocean-tile count, mean and maximum significant wave height for each acquisition.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"fue7HSmAJe"}],"key":"ip9aOFBkkk"}],"key":"KmtEjWBPsc"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Acquisition start times come from the product metadata, in UTC.\ntimes = pd.to_datetime([d.attrs[\"start_date\"] for d in datasets])\n\nstats = pd.DataFrame({\n    \"Date UTC\": pd.to_datetime(times),\n    \"Mean Hs (m)\": [float(w.mean()) for w in waves],\n    \"Max Hs (m)\": [float(w.max()) for w in waves],\n})\n\nstats.plot(x=\"Date UTC\", marker=\"o\", ylabel=\"Hs (m)\", figsize=(8, 4))\nplt.show()","key":"v7DDM2DBs1"},{"type":"outputs","id":"MFxfmUkWOJQcUBXvc8-cZ","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"a61b03b411d4764335185c308497ce6e","path":"/hackathon-notebooks/build/a61b03b411d4764335185c308497ce6e.png"},"text/plain":{"content":"<Figure size 800x400 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"nJoXKkCIiL"}],"key":"b6vfaMcoKb"}],"key":"lGqKg4MM8B"}],"key":"Vi4ufcyagC"},"references":{"cite":{"order":["https://doi.org/10.12770/1b05fc41-e06e-4285-ad7b-b97f6f847e00"],"data":{"https://doi.org/10.12770/1b05fc41-e06e-4285-ad7b-b97f6f847e00":{"label":"https://doi.org/10.12770/1b05fc41-e06e-4285-ad7b-b97f6f847e00","enumerator":"1","doi":"10.12770/1B05FC41-E06E-4285-AD7B-B97F6F847E00","html":"Nouguier Frederic, Mouche Alexis, Grouazel Antoine, Febvre Quentin, Maillard Lisa, & Marquart Robin. (2024). <i>SARWAVE Sentinel-1 Experimental Dataset - Level-2 WAV</i>. IFREMER. <a target=\"_blank\" rel=\"noreferrer\" href=\"https://doi.org/10.12770/1B05FC41-E06E-4285-AD7B-B97F6F847E00\">10.12770/1B05FC41-E06E-4285-AD7B-B97F6F847E00</a>","url":"https://doi.org/10.12770/1B05FC41-E06E-4285-AD7B-B97F6F847E00"}}}},"footer":{"navigation":{"prev":{"title":"Access OceanSODA-ETHZ","url":"/external-notebooks/ocean/datasets/ocean-soda/access","group":"Ocean Soda"},"next":{"title":"Access Scope","url":"/external-notebooks/ocean/datasets/scope/access","group":"Scope"}}},"domain":"http://localhost:3000"}